// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The credential lives in auth.json (/google-gemini-cli login);
// GOOGLE_CLOUD_PROJECT names the project of a paid tier at sign-in.
{
  "google-gemini-cli": {
    "enabled": true,

    // Where Cloud Code Assist is served. The lane appends
    // /v1internal:streamGenerateContent?alt=sse.
    "base_url": "https://cloudcode-pa.googleapis.com"
  }
}
