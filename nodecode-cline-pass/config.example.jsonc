// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or CLINE_API_KEY.
{
  "cline-pass": {
    "enabled": true,

    // Where ClinePass is served. The chat lane appends /chat/completions.
    "base_url": "https://api.cline.bot/api/v1"
  }
}
