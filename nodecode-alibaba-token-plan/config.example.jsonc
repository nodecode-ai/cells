// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect),
// ALIBABA_TOKEN_PLAN_API_KEY or BAILIAN_TOKEN_PLAN_API_KEY.
{
  "alibaba-token-plan": {
    "enabled": true,

    // Where the plan was bought. The two regions are separate products and
    // their keys do not cross:
    //   international  https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
    //   china          https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
    "region": "international"

    // Another regional endpoint, or a proxy; set, it wins over region. The
    // chat lane appends /chat/completions.
    // "base_url": "https://token-plan.<region>.maas.aliyuncs.com/compatible-mode/v1"
  }
}
