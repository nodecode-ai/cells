(in-package #:nodecode.test)

(defun matrix-chunk (text)
  (nck::make-text-chunk :text text :index 1 :total 1))

(deftest channel-matrix-an-answer-threads-under-its-ask ()
  (let* ((book (ncm:make-matrix-book))
         (target (list :channel-id "!room:fake"))
         (plan (ncm:message-plan book target (matrix-chunk "the **answer**") :reply-to "$ask" :ping t
                                 :mentions '("@kim:fake")))
         (body (nck:request-plan-body plan)))
    (is (equal "PUT" (nck:request-plan-method plan)))
    (is (uiop:string-prefix-p "/_matrix/client/v3/rooms/%21room%3Afake/send/m.room.message/nc"
                              (nck:request-plan-path plan))
        (nck:request-plan-path plan))
    (is (equal "m.text" (gethash "msgtype" body)) "the answer notifies")
    (is (equal "<p>the <strong>answer</strong></p>" (gethash "formatted_body" body)))
    (is (equal "m.thread" (nlk:json-value body :string "m.relates_to" "rel_type")))
    (is (equal "$ask" (nlk:json-value body :string "m.relates_to" "event_id")))
    (is (equalp #("@kim:fake") (nlk:json-array body "m.mentions" "user_ids")))
    (is (ncm:bot-thread-p book "!room:fake" "$ask") "the bot speaks in the ask's thread now"))
  (let* ((book (ncm:make-matrix-book))
         (target (list :channel-id "!dm:fake")))
    (setf (gethash "!dm:fake" (ncm::matrix-book-kinds book)) :direct)
    (let ((body (nck:request-plan-body (ncm:message-plan book target (matrix-chunk "status") :reply-to "$ask"))))
      (is (equal "m.notice" (gethash "msgtype" body)) "a post that may not notify is a notice")
      (is (null (nlk:json-value body :string "m.relates_to" "rel_type")) "a direct message threads nothing")
      (is (equal "$ask" (nlk:json-value body :string "m.relates_to" "m.in_reply_to" "event_id")))
      (is (equalp #() (nlk:json-array body "m.mentions" "user_ids")) "it mentions nobody by accident"))))

(deftest channel-matrix-an-edit-replaces-and-carries-its-controls ()
  (let* ((book (ncm:make-matrix-book))
         (target (list :channel-id "!room:fake"))
         (plan (ncm:edit-plan book target "$card" "working" :controls '(("Stop" "stop:x" :danger))))
         (body (nck:request-plan-body plan)))
    (is (equal "m.replace" (nlk:json-value body :string "m.relates_to" "rel_type")))
    (is (equal "$card" (nlk:json-value body :string "m.relates_to" "event_id")))
    (is (search "working" (nlk:json-value body :string "m.new_content" "body")))
    (is (search "stop" (nlk:json-value body :string "m.new_content" "body")) "the controls' hint rides the words")
    (is (= 1 (hash-table-count (ncm::matrix-book-pending book))) "the echo will know what the edit meant"))
  (let ((plan (ncm:delete-plan (list :channel-id "!room:fake") "$x")))
    (is (search "/rooms/%21room%3Afake/redact/%24x/" (nck:request-plan-path plan))))
  (let ((plan (ncm:typing-plan "@bot:fake" (list :channel-id "!room:fake"))))
    (is (search "/typing/%40bot%3Afake" (nck:request-plan-path plan)))
    (is (eq t (gethash "typing" (nck:request-plan-body plan))))))

(deftest channel-matrix-a-reaction-is-an-event-taken-off-by-redaction ()
  (let* ((book (ncm:make-matrix-book))
         (target (list :channel-id "!room:fake")))
    (setf (gethash "!room:fake|$ask|👀" (ncm::matrix-book-marks book)) "$mark")
    (let ((plans (ncm:reaction-plans book target "$ask" "✅" :previous "👀")))
      (is (= 2 (length plans)))
      (is (search "/redact/%24mark/" (nck:request-plan-path (first plans))) "the old mark is redacted")
      (is (equal "✅" (nlk:json-value (nck:request-plan-body (second plans)) :string "m.relates_to" "key"))))
    (is (null (ncm:reaction-plans book target "$ask" "✅" :previous "✅")) "the state asked for is there")))

(deftest channel-matrix-a-rate-limit-says-how-long ()
  (is (= 1500 (ncm:matrix-retry-after-ms 429 (nlk:json-object "errcode" "M_LIMIT_EXCEEDED" "retry_after_ms" 1500) nil)))
  (is (= 900 (ncm:matrix-retry-after-ms 429 "{\"errcode\":\"M_LIMIT_EXCEEDED\",\"retry_after_ms\":900}" nil)))
  (is (null (ncm:matrix-retry-after-ms 500 (nlk:json-object "retry_after_ms" 5) nil))))
