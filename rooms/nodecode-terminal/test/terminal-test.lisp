;;;; terminal-test.lisp --- a real shell on a real pty, and a page's socket to it.
;;;;
;;;; SPDX-License-Identifier: MIT

(in-package #:nodecode.test)

;;; --- the pty ------------------------------------------------------------------

(deftest terminal-cell-shell-runs-on-its-own-controlling-pty ()
  (with-test-terminal (watched)
    (type-line (watched-terminal watched) "echo tty=$(tty) ctty=$(ps -o tty= -p $$) sid=$(($(ps -o sid= -p $$)))")
    (is (await-text watched "tty=/dev/pts/") "the shell's stdin is a pty")
    (let ((text (watched-text watched))
          (pid (nodecode-terminal:terminal-pid (watched-terminal watched))))
      (is (search "ctty=pts/" text) "the pty is the shell's controlling terminal")
      (is (search (format nil "sid=~d" pid) text) "the shell leads a session of its own"))))

(deftest terminal-cell-resize-reaches-the-shell ()
  (with-test-terminal (watched :cols 100 :rows 30)
    (let ((terminal (watched-terminal watched)))
      (type-line terminal "echo size=$(stty size | tr ' ' x)")
      (is (await-text watched "size=30x100") "the size it was opened at")
      (type-line terminal "trap 'echo got-$((1+1))-winch' WINCH; echo trap-$((2+3))")
      (is (await-text watched "trap-5"))
      (nodecode-terminal:terminal-resize terminal 120 40)
      (is (await-text watched "got-2-winch") "a resize arrives as SIGWINCH")
      (type-line terminal "echo size=$(stty size | tr ' ' x)")
      (is (await-text watched "size=40x120") "and the new size is the pty's"))))

(deftest terminal-cell-ctrl-c-stops-the-foreground-job ()
  (with-test-terminal (watched)
    (let ((terminal (watched-terminal watched)))
      (type-line terminal "sleep 30; echo slept-$((3*4))")
      (sleep 0.5)
      (nodecode-terminal:terminal-write terminal (string (code-char 3)))
      (type-line terminal "echo rc=$((100+$?))")
      (is (await-text watched "rc=230" :timeout 3) "^C interrupts sleep: status 130")
      (is (not (search "slept-12" (watched-text watched))) "the rest of the line never runs"))))

(deftest terminal-cell-utf-8-round-trips ()
  (with-test-terminal (watched)
    (type-line (watched-terminal watched) "x='héllo ✓ 日本'; echo \"[${x}]-$((3*3))\"")
    (is (await-text watched "[héllo ✓ 日本]-9") "typed UTF-8 comes back as itself")))

(deftest terminal-cell-exit-code-is-told-and-the-shell-reaped ()
  (let* ((terminal (nodecode-terminal:open-terminal :command +test-shell+ :environment (test-environment)))
         (watched (watch terminal))
         (pid (nodecode-terminal:terminal-pid terminal)))
    (await-text watched "$ ")
    (type-line terminal "exit 7")
    (is (eql 7 (await-exit watched)) "the sink is told the exit code")
    (is (eql 7 (nodecode-terminal:terminal-exit terminal)))
    (is (not (pid-alive-p pid)) "the shell is reaped, not left a zombie")
    (let ((id (nodecode-terminal:terminal-id terminal)))
      (is (null (nodecode-terminal:find-terminal id)) "an ended terminal leaves the list"))))

(deftest terminal-cell-shell-inherits-only-its-stdio ()
  (with-test-terminal (watched)
    ;; The loop runs in the shell itself, so the list is the shell's own fds
    ;; (bash keeps a copy of the terminal on 255), not a subshell's pipes.
    (type-line (watched-terminal watched) "for f in /proc/$$/fd/*; do [ -e $f ] && printf '%s,' ${f##*/}; done; echo end-$((2+2))")
    (is (await-text watched "end-4"))
    (let ((fds (let ((found (nth-value 1 (cl-ppcre:scan-to-strings "([0-9,]+)end-4" (watched-text watched)))))
                 (and found (aref found 0)))))
      (is (member fds '("0,1,2," "0,1,2,255,") :test #'equal)
          (format nil "no fd of the image (sockets, the store) reaches the shell: ~s" fds)))))

(deftest terminal-cell-env-and-cwd ()
  (let ((folder (uiop:native-namestring (uiop:ensure-directory-pathname (uiop:temporary-directory)))))
    (with-test-terminal (watched :cwd folder)
      (type-line (watched-terminal watched) "echo \"term=$TERM/$COLORTERM pwd=$(pwd -P)/\"")
      (is (await-text watched "term=xterm-256color/truecolor"))
      (let ((pwd (format nil "pwd=~a" (namestring (truename folder)))))
        (is (await-text watched pwd) "the shell starts in the folder asked for")))))

(deftest terminal-cell-backlog-replays-and-is-bounded ()
  (with-test-terminal (watched)
    (let ((terminal (watched-terminal watched)))
      (type-line terminal "echo marker-$((40+2))")
      (is (await-text watched "marker-42"))
      (let ((late (watch terminal)))
        (is (search "marker-42" (watched-text late)) "a later attach gets what was printed before"))
      (type-line terminal "head -c 700000 /dev/zero | tr '\\0' x; echo; echo done-$((5*5))")
      (is (await-text watched "done-25" :timeout 10))
      (let ((late (watch terminal)))
        (is (<= (length (watched-bytes late)) (* 256 1024)) "the backlog keeps at most 256 KiB")
        (is (search "done-25" (watched-text late)) "and keeps the newest")))))

(deftest terminal-cell-close-ends-the-session ()
  (let* ((terminal (nodecode-terminal:open-terminal :command +test-shell+ :environment (test-environment)))
         (watched (watch terminal)))
    (await-text watched "$ ")
    (type-line terminal "sleep 300 & echo job-$((0+$!))-id")
    (loop repeat 250 until (cl-ppcre:scan "job-[0-9]+-id" (watched-text watched)) do (sleep 0.02))
    (let* ((found (nth-value 1 (cl-ppcre:scan-to-strings "job-([0-9]+)-id" (watched-text watched))))
           (job (and found (parse-integer (aref found 0))))
           (pid (nodecode-terminal:terminal-pid terminal)))
      (is (and job (pid-alive-p job)) "the background job runs")
      (nodecode-terminal:close-terminal terminal)
      (is (not (pid-alive-p pid)) "close ends the shell")
      (is (loop repeat 150 thereis (not (and job (pid-alive-p job))) do (sleep 0.02))
          (format nil "and the jobs it started: ~a"
                  (uiop:run-program (format nil "ps -o pid,ppid,pgid,sid,stat,cmd -p ~d" job)
                                    :output :string :ignore-error-status t))))))

;;; --- the page and its socket ----------------------------------------------------

(deftest terminal-cell-serves-its-page (with-temp-gateway (port))
  (with-cell-stop ((terminal-start))
    (multiple-value-bind (body status headers) (nlk:http :get (format nil "http://127.0.0.1:~d/terminal/" port))
      (is (= 200 status) "the page answers without the operator token")
      (is (search "<title>Terminal</title>" body))
      (is (search "script-src 'self'" (gethash "content-security-policy" headers)) "runs only its own scripts"))
    (dolist (name '("terminal.js" "xterm.js" "addon-fit.js" "xterm.css" "terminal.css"))
      (is (= 200 (nth-value 1 (nlk:http :get (format nil "http://127.0.0.1:~d/terminal/~a" port name)))) name))
    (dolist (outside '("/terminal/cell.lisp" "/terminal/../cell.lisp" "/terminal/.hidden" "/terminal/NOTICE"))
      (is (= 404 (raw-gateway-status port outside (format nil "Host: 127.0.0.1:~d" port))) outside))))

(deftest terminal-cell-socket-wants-the-token (with-temp-gateway (port))
  (with-cell-stop ((terminal-start))
    (let ((client (open-client port)))
      (client-send client "type" "open")
      (is (equal "error" (gethash "type" (client-next client))) "nothing opens before hello")
      (let ((next (client-next client)))
        (is (eq :closed next) (format nil "and the socket is closed: ~s" next))))
    (let ((client (open-client port)))
      (client-send client "type" "hello" "token" "not-the-token")
      (is (equal "error" (gethash "type" (client-next client))) "a wrong token is refused")
      (is (eq :closed (client-next client))))
    (let ((client (open-client port)))
      (client-send client "type" "hello" "token" "test-token")
      (is (client-next client :type "welcome") "the operator token is let in")
      (close-client client))))

(deftest terminal-cell-socket-refuses-a-foreign-origin (with-temp-gateway (port))
  (with-cell-stop ((terminal-start))
    (let ((status (raw-gateway-status port "/api/terminal/socket"
                                      (format nil "Host: 127.0.0.1:~d" port)
                                      "Origin: https://evil.example"
                                      "Upgrade: websocket" "Connection: Upgrade"
                                      "Sec-WebSocket-Version: 13"
                                      "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==")))
      (is (= 403 status) "another site's page cannot open the socket"))))

(deftest terminal-cell-socket-opens-types-and-reads (with-temp-gateway (port))
  (with-cell-stop ((terminal-start))
    (with-test-shell-for-sockets
      (let ((client (open-client port :origin (format nil "http://127.0.0.1:~d" port))))
        (client-send client "type" "hello" "token" "test-token")
        (client-next client :type "welcome")
        (client-send client "type" "open" "cols" 90 "rows" 20)
        (let ((opened (client-next client :type "opened")))
          (is opened "open answers opened")
          (is (eql 90 (and opened (gethash "cols" opened)))))
        (client-await-text client "$ ")
        (client-send client "type" "input" "data" (format nil "echo out-$((7*8)) $(stty size | tr ' ' x)~c" #\Return))
        (is (client-await-text client "out-56 20x90") "typed input runs; output comes down")
        (client-send client "type" "resize" "cols" 132 "rows" 43)
        (client-send client "type" "input" "data" (format nil "echo now-$(stty size | tr ' ' x)~c" #\Return))
        (is (client-await-text client "now-43x132") "a resize frame resizes the pty")
        (client-send client "type" "input" "data" (format nil "exit 3~c" #\Return))
        (let ((exit (client-next client :type "exit")))
          (is (eql 3 (and exit (gethash "code" exit))) "the page is told the exit code"))
        (close-client client)))))

(deftest terminal-cell-socket-reattaches-after-a-drop (with-temp-gateway (port))
  (with-cell-stop ((terminal-start))
    (with-test-shell-for-sockets
      (let ((first (open-client port)) id)
        (client-send first "type" "hello" "token" "test-token")
        (client-next first :type "welcome")
        (client-send first "type" "open")
        (setf id (gethash "id" (client-next first :type "opened")))
        (client-await-text first "$ ")
        (client-send first "type" "input" "data" (format nil "echo before-$((9*9))~c" #\Return))
        (is (client-await-text first "before-81"))
        (close-client first)
        (sleep 0.3)
        (let ((terminal (nodecode-terminal:find-terminal id)))
          (is terminal "the terminal outlives the page that opened it"))
        (let ((second (open-client port)))
          (client-send second "type" "hello" "token" "test-token")
          (client-next second :type "welcome")
          (client-send second "type" "attach" "id" id)
          (is (client-next second :type "attached") "a new page attaches by id")
          (is (client-await-text second "before-81") "and redraws from the backlog")
          (client-send second "type" "input" "data" (format nil "echo after-$((8*8))~c" #\Return))
          (is (client-await-text second "after-64") "and types into the same shell")
          (client-send second "type" "close")
          (is (client-next second :type "exit") "close ends it")
          (close-client second))))))

(deftest terminal-cell-a-quiet-socket-stays-open ()
  ;; A terminal nobody types into sends nothing; the gateway hangs up what is
  ;; silent for its read timeout unless the client answers pings.
  (let ((nle::*gateway-connection-read-timeout* 1))
    (with-saved-globals ((nodecode-terminal::*ping-seconds* 0.3))
      (with-temp-gateway (port)
        (with-cell-stop ((terminal-start))
          (let ((client (open-client port)))
            (client-send client "type" "hello" "token" "test-token")
            (is (client-next client :type "welcome"))
            (sleep 3)
            (is (eq :open (wsd:ready-state (client-ws client))) "pinged, a quiet socket stays open")
            (close-client client)))))))

(deftest terminal-cell-two-terminals-are-separate ()
  (with-test-terminal (one)
    (with-test-terminal (two)
      (type-line (watched-terminal one) "v=$((1+1)); echo one-$v")
      (type-line (watched-terminal two) "echo two-${v:-unset}")
      (is (await-text one "one-2"))
      (is (await-text two "two-unset") "a variable in one shell is not in the other")
      (is (/= (nodecode-terminal:terminal-pid (watched-terminal one))
              (nodecode-terminal:terminal-pid (watched-terminal two)))))))
