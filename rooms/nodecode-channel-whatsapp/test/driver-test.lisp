;;;; driver-test.lisp --- the wire and the executor, over a fake driver.
;;;;
;;;; SPDX-License-Identifier: MIT

(in-package #:nodecode.test)

(deftest channel-whatsapp-the-wire-answers-each-call ()
  (let ((fake (make-fake-wa)))
    (multiple-value-bind (status result error) (ncw:driver-call (fake-wa-driver fake) "status" nil)
      (is (= 200 status))
      (is (equal +wa-bot+ (gethash "phone" result)))
      (is (null error)))
    (push (list* "edit" 400 "WhatsApp allows an edit for 20m0s") (fake-wa-refusals fake))
    (multiple-value-bind (status result error) (ncw:driver-call (fake-wa-driver fake) "edit"
                                                                (nlk:json-object "chat" "x" "id" "y"))
      (is (= 400 status) "a refusal keeps its status")
      (is (null result))
      (is (search "20m0s" error) "and says why"))
    (is (equal '("status" "edit") (fake-wa-ops fake)) "every request reached the driver"))
  (let ((silent (ncw:make-driver :send (lambda (line) (declare (ignore line))))))
    (multiple-value-bind (status result error) (ncw:driver-call silent "status" nil :timeout 0.3)
      (is (= 0 status) "no answer is status 0")
      (is (null result))
      (is (search "did not answer" error))))
  (let ((driver (ncw:make-driver :send (lambda (line) (declare (ignore line))))))
    (ncw:driver-accept-line driver "{\"event\":\"message\",\"n\":1}")
    (ncw:driver-accept-line driver "{\"event\":\"reaction\",\"n\":2}")
    (is (equal "message" (gethash "event" (ncw:driver-next-event driver 0.1))) "events in the order written")
    (is (equal "reaction" (gethash "event" (ncw:driver-next-event driver 0.1))))
    (is (null (ncw:driver-next-event driver 0.1)) "none left is NIL after the wait")
    (setf (ncw::driver-live driver) nil)
    (is (search "not running" (nth-value 2 (ncw:driver-call driver "status" nil))) "a dead driver answers at once")))

(deftest channel-whatsapp-a-composite-post-runs-as-its-messages ()
  (let* ((fake (make-fake-wa))
         (sent '())
         (executor (ncw:make-driver-executor (lambda () (fake-wa-driver fake))
                                             :on-sent (lambda (op args result)
                                                        (push (list op (gethash "chat" args)
                                                                    (nck:execution-ok-p result))
                                                              sent))))
         (yes (nck:press-token "yes"))
         (plan (ncw:send-message-plan (ncw:make-whatsapp-book) (list :channel-id (wa-jid +wa-kim+))
                                      (wa-chunk "Ready?") :reply-to "ASK1"
                                      :files (list #p"/tmp/a.png")
                                      :controls (list (list (list "Yes" yes) (list "No" (nck:press-token "no"))))))
         (result (nck:execute-plan executor plan)))
    (is (nck:execution-ok-p result))
    (is (equal '("send_file" "send" "poll") (fake-wa-ops fake)) "the file, then the words, then the poll")
    (is (equal "BOT2" (ncw:whatsapp-message-id (nck:execution-body result))) "the post is its words' message")
    (is (equal "ASK1" (gethash "quote" (first (fake-wa-calls fake "send_file")))) "the file quotes the ask too")
    (is (null (gethash "__poll" (first (fake-wa-calls fake "send")))) "the words carry no poll")
    (is (equalp #("Yes" "No") (gethash "options" (first (fake-wa-calls fake "poll")))))
    (is (equal '("send_file" "send" "poll") (reverse (mapcar #'first sent))) "each landing is heard"))
  (let* ((fake (make-fake-wa))
         (executor (ncw:make-driver-executor (lambda () (fake-wa-driver fake)))))
    (push (list* "send" 503 "not connected to WhatsApp right now") (fake-wa-refusals fake))
    (let ((result (nck:execute-plan executor (ncw:op-plan "send" (nlk:json-object "chat" "x" "text" "y") "send_message"
                                                          :retry t))))
      (is (not (nck:execution-ok-p result)))
      (is (= 3 (nck:execution-attempts result)) "a plan that opts in is tried through a reconnect")
      (is (search "not connected" (nck:execution-error result))))
    (let ((result (nck:execute-plan executor (ncw:op-plan "send" (nlk:json-object "chat" "x" "text" "y") "typing_indicator"))))
      (is (= 1 (nck:execution-attempts result)) "one that does not is tried once"))
    (is (nck:execution-ok-p (nck:execute-plan executor nil)) "a NIL plan is a beat WhatsApp cannot show: done")))
