// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority. A present section is
// enabled; "enabled": false vetoes it.
{
  "channels": {
    "fivedive": {
      "spool_dir": "~/.nodecode/channels/5dive",  // the 5dive bridge's folder: inbox/ and outbox/<chat>/ inside it
      "allowed_senders": ["5dive-app"],           // the sender the bridge writes as
      "allow_all": false,
      "reply_max_words": 70,                       // 0 turns the cap off
      "poll_seconds": 1,
      "max_length": 16000
    }
  }
}