(in-package #:nodecode.test)

(defun imessage-chunk (text &optional (index 1) (total 1))
  (nck::make-text-chunk :text text :index index :total total))

(defun imessage-book (&key (private-api t))
  (let ((book (nci:make-imessage-book)))
    (setf (nci::imessage-book-private-api book) private-api)
    book))

(deftest channel-imessage-a-group-answer-replies-inline ()
  (let* ((book (imessage-book))
         (group (list :channel-id "iMessage;+;chat42"))
         (plan (nci:message-plan book group (imessage-chunk "the **answer**") :reply-to "ASK" :ping t))
         (body (nck:request-plan-body plan)))
    (is (equal "POST" (nck:request-plan-method plan)))
    (is (equal "/api/v1/message/text" (nck:request-plan-path plan)) "the password is the executor's")
    (is (equal "the answer" (gethash "message" body)) "Markdown is spelled plain")
    (is (equal "private-api" (gethash "method" body)))
    (is (equal "ASK" (gethash "selectedMessageGuid" body)) "an inline reply under the ask")
    (is (uiop:string-prefix-p "temp-nc-" (gethash "tempGuid" body)))
    (is (not (nck:request-plan-retry-server-errors plan)) "a send is never said twice")
    (is (nci::bot-message-p book "ASK") "the bot speaks in the ask's thread now")
    (is (null (gethash "selectedMessageGuid"
                       (nck:request-plan-body (nci:message-plan book group (imessage-chunk "two" 2 2) :reply-to "ASK"))))))
  (let ((body (nck:request-plan-body (nci:message-plan (imessage-book) (list :channel-id "iMessage;-;+15550001")
                                                       (imessage-chunk "hi") :reply-to "ASK"))))
    (is (null (gethash "selectedMessageGuid" body)) "a direct message is answered plainly"))
  (let ((body (nck:request-plan-body (nci:message-plan (imessage-book :private-api nil) (list :channel-id "iMessage;+;chat42")
                                                       (imessage-chunk "hi") :reply-to "ASK"))))
    (is (equal "apple-script" (gethash "method" body)) "without the Private API, AppleScript sends")
    (is (null (gethash "selectedMessageGuid" body)) "and replies inline to nothing")))

(deftest channel-imessage-a-card-is-never-posted ()
  (let* ((book (imessage-book))
         (target (list :channel-id "iMessage;+;chat42"))
         (card (nci:message-plan book target (imessage-chunk "working") :card '(:state :working))))
    (is (equal "NOOP" (nck:request-plan-method card)))
    (let ((id (nci:imessage-message-id (nck:request-plan-body card))))
      (is (nci:card-id-p id))
      (is (equal "NOOP" (nck:request-plan-method (nci:edit-plan book target id "still" :card '(:state :working)))))
      (let ((done (nci:edit-plan book target id "done" :card '(:state :done))))
        (is (equal "DELETE" (nck:request-plan-method done)) "an ended turn stops the typing bubble")
        (is (equal "/api/v1/chat/iMessage%3B%2B%3Bchat42/typing" (nck:request-plan-path done))))
      (let ((failed (nci:edit-plan book target id "**failed**: the provider refused" :card '(:state :failed))))
        (is (equal "/api/v1/message/text" (nck:request-plan-path failed)) "a failed turn says so in a message")
        (is (equal "failed: the provider refused" (gethash "message" (nck:request-plan-body failed)))))
      (is (equal "DELETE" (nck:request-plan-method (nci:delete-plan book target id))))
      (is (equal "NOOP" (nck:request-plan-method (nci:delete-plan (imessage-book :private-api nil) target id)))))
    (is (equal "FAIL" (nck:request-plan-method (nci:delete-plan (imessage-book :private-api nil) target "G9"))))
    (is (equal "/api/v1/message/G9/unsend" (nck:request-plan-path (nci:delete-plan book target "G9"))))
    (is (equal "NOOP" (nck:request-plan-method (nci:typing-plan (imessage-book :private-api nil) target))))))

(deftest channel-imessage-choices-ride-the-words ()
  (let* ((book (imessage-book))
         (target (list :channel-id "iMessage;-;+15550001"))
         (plan (nci:message-plan book target (imessage-chunk "Which?")
                                 :controls '((("Opus" "p1" :primary) ("Flash" "p2" :secondary))))))
    (is (equal (format nil "Which?~%~%1. Opus~%2. Flash") (gethash "message" (nck:request-plan-body plan))))
    (is (equal '(("Opus" "p1") ("Flash" "p2")) (gethash "__choices" (nck:request-plan-body plan))))))

(deftest channel-imessage-the-kits-marks-are-tapbacks ()
  (let ((book (imessage-book))
        (target (list :channel-id "iMessage;+;chat42")))
    (let ((plans (nci:reaction-plans book target "ASK" "👀")))
      (is (= 1 (length plans)))
      (is (equal "/api/v1/message/react" (nck:request-plan-path (first plans))))
      (is (equal '("emphasize" "ASK" 0)
                 (let ((body (nck:request-plan-body (first plans))))
                   (list (gethash "reaction" body) (gethash "selectedMessageGuid" body) (gethash "partIndex" body))))))
    (is (equal "like" (gethash "reaction" (nck:request-plan-body (first (nci:reaction-plans book target "ASK" "✅" :previous "👀"))))))
    (is (equal "-like" (gethash "reaction" (nck:request-plan-body (first (nci:reaction-plans book target "ASK" nil :previous "✅"))))))
    (is (null (nci:reaction-plans book target "ASK" "✅" :previous "✅")) "the state asked for is there")
    (is (null (nci:reaction-plans (imessage-book :private-api nil) target "ASK" "👀")))))

(deftest channel-imessage-the-password-rides-the-query ()
  (let* ((plain (nci::read-plan "/server/info" "server_info"))
         (keyed (nci::with-password plain "p&w")))
    (is (equal "/api/v1/server/info?password=p%26w" (nck:request-plan-path keyed))))
  (is (search "&password=x" (nck:request-plan-path
                             (nci::with-password (nck::make-request-plan :path "/api/v1/chat/a/message?limit=2") "x"))))
  (let ((body (nck:request-plan-body (nci:query-plan 41 :limit 7))))
    (is (equal 41 (nlk:json-value (aref (gethash "where" body) 0) :integer "args" "rowid")))
    (is (equal "ASC" (gethash "sort" body)))))
