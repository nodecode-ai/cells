// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json (/cursor login), or the token in
// CURSOR_ACCESS_TOKEN or CURSOR_API_KEY.
{
  "cursor": {
    "enabled": true,

    // Where Cursor's agent service is served. A run goes to
    // <base_url>/agent.v1.AgentService/RunSSE and
    // <base_url>/aiserver.v1.BidiService/BidiAppend.
    "base_url": "https://api2.cursor.sh"
  }
}
