// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority. A present section is
// enabled; "enabled": false vetoes it, and then nothing is registered.
// Nothing here is required: Nager.Date answers without a key.
{
  "holidays": {
    "base_url": "https://date.nager.at/api/v3",   // the API root, for a proxy of your own
    "subdivision": "",                              // e.g. DE-NI: the region every call counts unless it names one
    "weekend": "Saturday, Sunday",                 // names or 0-6 (Monday 0), comma separated
    "timeout_seconds": 10,                         // one API call's ceiling
    "max_span_days": 3660                          // the longest range one workdays_count walks
  }
}
