// The cell's section of ~/.nodecode/config.jsonc. A present section is an
// enabled one; "enabled": false vetoes the cell and installs nothing.
"homeassistant": {
  // The instance's base URL, http:// or https:// included.
  "url": "http://homeassistant.local:8123",

  // The token is named, never written here: an environment variable
  // (token_env) or a file only you can read (token_file). Set exactly one.
  "token_env": "HASS_TOKEN",
  // "token_file": "~/.config/home-assistant-token",

  // Optional: entity ids or patterns the four tools are limited to.
  // "entity_allowlist": ["climate.*", "sensor.office_*"],
  // Optional: patterns the tools always exclude; it wins over the allowlist.
  // "entity_denylist": ["office_thermostat_*"],

  // Optional: a cap on ha_list_entities answers.
  // "max_entities": 200,

  // How long one request to the instance may take, in seconds.
  "timeout": 15
}
