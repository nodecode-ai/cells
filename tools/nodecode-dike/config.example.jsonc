// The section ~/.nodecode/config.jsonc may carry for this cell -- documentation,
// not config: the folder gets pushed and holds no secret. The declaration in
// cell.lisp is the authority. A present section is enabled; "enabled": false
// vetoes it; every setting here is optional.
{
  "dike": {
    "enabled": true,
    // the date vigencia is judged at, as YYYY-MM-DD; empty is today
    "as_of": "",
    // the longest brief, in UTF-8 bytes
    "max_bytes": 400000
  }
}
