// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "construct": {
    "enabled": true,
    // where the projects live: a full path; empty keeps them under the home
    "projects_folder": "",
    // sides on a curved shape (cylinder, cone, sphere)
    "segments": 24
  }
}
