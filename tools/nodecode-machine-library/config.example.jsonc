// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// A present section is enabled; "enabled": false vetoes it.
{
  "machine-library": {
    "enabled": true,

    // The key from machinelibrary.ai/keys. Searches spend its prepaid
    // credits. A pasted key is kept in a 0600 file under ~/.nodecode/secrets/
    // and this section is pointed at that file instead.
    "api_key": "...",

    // Or the name of the environment variable holding it.
    // MACHINELIBRARY_API_KEY is read either way, so an exported key needs no
    // section at all.
    "api_key_env": "MACHINELIBRARY_API_KEY",

    // Only for a proxy or a gateway of your own.
    // "base_url": "https://api.machinelibrary.ai",

    // The public site the cited page urls are built on.
    // "site_url": "https://machinelibrary.ai",

    // One search or document fetch's ceiling, in seconds.
    "timeout_seconds": 60,

    // How many sources a search answers with unless the call names its own
    // count; at most 20.
    "max_results": 5,

    // How much of the matching passage one search result carries.
    "snippet_chars": 600,

    // How much of one document's text an extract carries. The provider read
    // up to 20000 and let the harness cut it to 15000.
    "max_chars": 12000
  }
}
