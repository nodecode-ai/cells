// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. Nothing is required: the hosted server needs no key or account. A
// present section is enabled; "enabled": false vetoes it.
{
  "dyscalculia": {
    "enabled": true,
    "base_url": "https://mcp.dyscalculia.io/mcp",
    "timeout_seconds": 30,
    "max_chars": 8000
  }
}
