// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
{
  "otel": {
    // An OTLP/HTTP traces URL. Empty (the default) keeps every span in
    // ~/.nodecode/otel/spans.jsonl and sends nothing.
    "endpoint": "http://localhost:6006/v1/traces",
    // Extra request headers, each "Name: value"; ${VAR} reads the
    // environment, so the secret itself stays out of this file.
    "headers": ["x-api-key: ${PHOENIX_API_KEY}"],
    // The name of an environment variable holding a bearer token.
    "api_key_env": null,
    "service_name": "nodecode",
    // full sends whole tool arguments and results; preview sends the first
    // preview_chars of each; off sends no text at all.
    "content_capture": "preview",
    "preview_chars": 1200,
    "local_store": true,
    "max_spans": 500,
    "flush_seconds": 5,
    "timeout_seconds": 10
  }
}
