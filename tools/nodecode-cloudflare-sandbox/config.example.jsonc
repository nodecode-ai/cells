// The section ~/.nodecode/config.jsonc may carry for this cell.
// Documentation, not config: the declaration in cell.lisp is the authority.
// A present section is enabled; "enabled": false vetoes it.
{
  "cloudflare-sandbox": {
    "endpoint": "https://your-worker.your-subdomain.workers.dev",
    "token_env": "CLOUDFLARE_SANDBOX_TOKEN",
    // or, pasted here (kept in a 0600 file, and this file holds no secret):
    // "token": "the same value as the Worker's SANDBOX_API_TOKEN",
    "namespace": "default",
    // "workspace": "project-a",
    "image": "hermes",
    // "instance": "standard-1",
    "persistent": true,
    "cwd": "/workspace",
    "timeout_seconds": 120
  }
}
