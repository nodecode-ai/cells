// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
{
  "gbrain-pointer": {
    "enabled": true,
    "mcp_url": "http://127.0.0.1:3131/mcp",
    "access_token": "",          // a pre-minted token, or the pair below
    "client_id": "",             // gbrain mcp grant --profile memory-reader
    "client_secret": "",
    "source": "",                // one GBrain source id, or every source
    "limit": 3,                   // pointers a turn carries, 1 to 10
    "auto": true,                 // search in the background each turn
    "allow_http": false,          // plain http to a host that is not loopback
    "timeout_seconds": 12
  }
}
