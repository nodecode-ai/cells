// The section ~/.nodecode/config.jsonc may carry for this cell. The
// declaration in cell.lisp is the authority; this is an illustration of it.
// A present section is enabled; "enabled": false vetoes it.
{
  "agenda-guardian": {
    "enabled": true,
    "data_dir": "~/agenda/",
    "calendar": "",
    "work_hours": "09:00-18:00",
    "workdays": "mon-fri",
    "protected": "lunch 12:30-13:30",
    "focus": "09:00-11:30",
    "buffer_min": 10,
    "max_block_min": 50,
    "max_tasks_per_day": 3
  }
}
