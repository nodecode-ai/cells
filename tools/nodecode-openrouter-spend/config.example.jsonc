// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. The declaration in cell.lisp is the authority.
// A present section is enabled; "enabled": false vetoes it. The key itself
// is never here: key_env names the variable that holds it.
{
  "openrouter-spend": {
    "enabled": true,
    "key_env": "OPENROUTER_API_KEY",
    "cache_seconds": 30,
    "timeout_seconds": 8,
    "usd_inr_rate": "",
    "fx_cache_seconds": 43200,
    "comparison_usd": "110",
    "comparison_label": "Codex",
    "history_file": ""
  }
}
