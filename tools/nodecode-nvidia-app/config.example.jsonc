// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "nvidia-app": {
    "enabled": true,
    // NVIDIA App publishes its MCP address and token here, and rewrites the
    // file whenever either changes; leave this out to read the standard place,
    // %LOCALAPPDATA%\NVIDIA Corporation\NVIDIA App\McpServer\server.json
    "server_json": "D:/NVIDIA/server.json",
    // Only when the app publishes nothing: the published file wins.
    "url": "http://127.0.0.1:47985/mcp",
    "timeout_seconds": 30
  }
}
