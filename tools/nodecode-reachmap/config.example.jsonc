// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. The declaration in cell.lisp is the authority;
// this is an illustration of it. Every member is optional: an empty section,
// or none at all, maps the usual ports and the CLIs on PATH.
{
  "reachmap": {
    "enabled": true,
    "cdp_ports": ["9222", "9229"],
    "extra_ports": ["5679"],
    "scanners": ["browser", "service", "cli", "drive"],
    "auth_probes": ["gh"],
    "hide_identities": false,
    "cache_seconds": 90,
    "timeout_seconds": 2
  }
}
