// The section ~/.nodecode/config.jsonc may carry for this cell -
// documentation, not config. The declaration in cell.lisp is the authority;
// this is an illustration of it, with every default written out.
{
  "toolaria": {
    "enabled": true,
    "max_result_chars": 12000,
    "head_lines": 40,
    "tail_lines": 15,
    "excerpt_max_chars": 8000,
    "fetch_max_chars": 4000,
    "full_fetch_max_chars": 50000,
    "store_path": "~/.nodecode/toolaria",
    "ttl_hours": 72,
    "keep_out": ["rescuer_fetch", "eval"]
  }
}
