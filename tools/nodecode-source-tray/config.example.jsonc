// The section ~/.nodecode/config.jsonc may carry for the source tray --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it, and an absent one runs on the defaults below.
{
  "source-tray": {
    // The most URLs one session's tray keeps, the original plugin's 40 by
    // default. Opening a URL again updates it in place; past this many the
    // oldest leave the list.
    "max_items": 40,

    // The tool calls whose arguments and answers the tray reads. These are
    // the original's five, plus Nodecode's own host-fetch name; a name no
    // cell provides is simply never seen.
    "tools": ["web_search", "web_extract", "web_fetch", "browser_navigate", "browser_open"]
  }
}
