// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder holds no secret. The declaration in
// cell.lisp is the authority; this is an illustration of it, with the
// defaults, which are the original plugin's numbers. A present section is
// enabled; "enabled": false vetoes it.
{
  "sentinel": {
    "enabled": true,
    "loop_guard": true,
    "loop_threshold": 3,
    "bound_results": true,
    "max_chars": 4000,
    "max_lines": 100,
    "redact": true,
    "guard_messages": true,
    "audit_limit": 200
  }
}
