{
  "delegation": {
    // model_map hands the agent the names below; default keeps every
    // subagent on the parent's model (and refuses a route out loud).
    "backend": "model_map",
    // What a task that picks no route runs on. Empty: the parent's model.
    "default_route": "fast",
    // How long one delegated subagent's turn may run.
    "seconds": 900,
    // One object per route: the name and the line are all the model sees.
    "routes": [
      { "name": "fast",
        "description": "Cheap and quick: lookups, summaries, simple edits.",
        "provider": "openrouter",
        "model": "google/gemini-3-flash-preview" },
      { "name": "deep",
        "description": "Slow and careful: hard debugging and design work.",
        "provider": "anthropic",
        "model": "claude-opus-5",
        "reasoning_effort": "high" }
    ]
  }
}
