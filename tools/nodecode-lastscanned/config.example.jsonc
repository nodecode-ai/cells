// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority. A present section is
// enabled; "enabled": false vetoes it. No key is required: the free daily
// allowance answers without one.
{
  "lastscanned": {
    "api_key_env": "LASTSCANNED_API_KEY",              // the variable holding the key, or "api_key" inline
    "base_url": "https://mcp.lastscanned.com/mcp",     // the MCP endpoint, for a proxy of your own
    "timeout_seconds": 30                               // one call's ceiling
  }
}
