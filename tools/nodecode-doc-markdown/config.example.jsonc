// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "doc-markdown": {
    "enabled": true,
    // the largest file read, in bytes (20 MiB)
    "max_file_bytes": 20971520,
    // the longest Markdown returned, in characters
    "max_output_chars": 200000,
    // refuse a path with a component that starts with ".", after every
    // symbolic link is followed
    "refuse_hidden": true
  }
}
