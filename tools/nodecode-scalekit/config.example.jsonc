// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// A present section is enabled; "enabled": false vetoes it.
{
  "scalekit": {
    "enabled": true,

    // From the Scalekit dashboard: Developers, Settings, API Credentials.
    // A pasted secret is kept in a 0600 file under ~/.nodecode/secrets/ and
    // this section is pointed at that file instead.
    "client_id": "skc_...",
    "client_secret": "test_...",

    // The environment's own address, https://your-env.scalekit.dev.
    "environment_url": "https://your-env.scalekit.dev",

    // The person these connections act for, as Scalekit knows them (an email
    // works). Leave it empty to use the usr_ id this machine generated once.
    // "identifier": "person-42",

    // One Scalekit request's ceiling, in seconds.
    "timeout_seconds": 30,

    // How much of one tool result an answer carries.
    "max_chars": 4000
  }
}
