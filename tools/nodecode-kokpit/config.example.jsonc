// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder is pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
{
  "kokpit": {
    "enabled": true,
    // the one thing this cell needs: the folder of Markdown notes it reads
    // and appends to. Nothing is written outside it.
    "vault": "~/Kokpit",
    // the files and folders, as names inside the vault (or absolute paths)
    "threads_file": "Threads.md",
    "todo_file": "To-Do.md",
    "last_session_file": "Last-Session.md",
    "inbox_dir": "inbox",
    "receipts_dir": "receipts",
    "journal_dir": "daily",
    // a thread with no change for this many days gets a night proposal
    "stale_days": 7,
    // how long the brief may get, in characters
    "brief_chars": 3500
  }
}
