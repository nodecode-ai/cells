// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. Nothing here is required and nothing here is a secret.
{
  "gonogo": {
    "enabled": true,

    // The accuracy a deployment needs, in percent: what a call that names no
    // :target is measured against, on the pass rate's lower bound. A call may
    // always pass its own target.
    "default_target_percent": 95
  }
}
