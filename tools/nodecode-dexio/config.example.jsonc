// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority. A present section is
// enabled; "enabled": false vetoes it.
{
  "dexio": {
    "api_key": "dxk_...",           // or name the variable below, or just DEXIO_API_KEY
    "api_key_env": "DEXIO_API_KEY",
    "url": "https://app.dexio.wiki", // your own Dexio server, if you self-host one
    "agent": "nodecode",              // the name Dexio records on every page this writes
    "auto_recall": true,              // the pages matching each request, in front of the model
    "max_results": 4,                 // pages per recall or search, 1 to 10
    "recall_chars": 3000,             // the longest recall one request carries
    "timeout_seconds": 6
  }
}
