// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it. The
// tokens themselves are not here: the sign-in writes them to a 0600 file
// under the home (spotify/auth.json).
{
  "spotify": {
    "enabled": true,
    // Your Spotify app's Client ID: developer.spotify.com/dashboard,
    // Create app, Web API ticked, redirect URI as below.
    "client_id": "your-spotify-app-client-id",
    "redirect_uri": "http://127.0.0.1:43827/spotify/callback",
    "api_base_url": "https://api.spotify.com/v1",
    "accounts_base_url": "https://accounts.spotify.com"
  }
}
