;;;; templates.lisp --- the two archetypes, as text.
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; What the foundry writes is a cell like any other: a system, one
;;;; CELL.LISP with the package, a section, a tool, a /command and a worker,
;;;; its test slice, a README and the section's example config. The text here
;;;; carries {{placeholders}} only: no generated folder names a machine, a
;;;; person or a service of its own.

(in-package #:nodecode-foundry)

(defun text-lines (&rest lines)
  "LINES as one text, a newline after each."
  (with-output-to-string (out)
    (dolist (line lines)
      (write-string line out)
      (terpri out))))

;;; --- the parts both archetypes share ------------------------------------------

(defparameter *asd*
  (text-lines
   ";;;; nodecode-{{slug}}.asd --- {{short}}."
   ";;;;"
   ";;;; SPDX-License-Identifier: MIT"
   ";;;;"
   ";;;; Written by the foundry cell for one request; read it, then put the"
   ";;;; folder under ~/.nodecode/cells/ and it loads at the next boot."
   ""
   "(defsystem \"nodecode-{{slug}}\""
   "  :description \"{{short}}\""
   "  :license \"MIT\""
   "  :version \"0.1.0\""
   "  :depends-on (\"nodecode\")"
   "  :components ((:file \"cell\"))"
   "  :in-order-to ((test-op (test-op \"nodecode-{{slug}}/test\"))))"
   ""
   "(defsystem \"nodecode-{{slug}}/test\""
   "  :depends-on (\"nodecode-{{slug}}\" \"nodecode/test\")"
   "  :pathname \"test/\""
   "  :components ((:file \"cell-test\"))"
   "  :perform (test-op (operation component)"
   "                    (uiop:symbol-call '#:nodecode.test '#:run-{{slug}}-tests)))")
  "The generated system and its test system.")

(defparameter *test*
  (text-lines
   ";;;; cell-test.lisp --- the generated cell's slice."
   ";;;;"
   ";;;; SPDX-License-Identifier: MIT"
   ""
   "(in-package #:nodecode.test)"
   ""
   "(define-test-slice \"{{slug}}\" \"{{upper}}-\" :start nodecode-{{slug}}:start-cell)"
   ""
   "(define-cell-lifecycle-tests \"{{slug}}\""
   "  (:command \"{{slug}}\")"
   "  (:help :{{slug}}))"
   ""
   "(deftest {{slug}}-cell-the-command-answers ()"
   "  (with-cell-stop ((nodecode-{{slug}}-start))"
   "    (let ((line (nodecode-{{slug}}:run-command \"\" \"s1\")))"
   "      (is (stringp line) \"the command answers a line\")"
   "      (is (plusp (length line)) \"and it is not empty\"))))")
  "The generated test slice: the lifecycle every cell's folder carries, and one answer.")

