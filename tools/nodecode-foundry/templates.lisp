;;; --- the folder watcher -------------------------------------------------------

(defparameter *watcher-cell*
  (text-lines
   ";;;; cell.lisp --- new {{ext}} files in {{source-name}}, as a tool and /{{slug}}."
   ";;;;"
   ";;;; SPDX-License-Identifier: MIT"
   ";;;;"
   ";;;; Written by the foundry cell for one request: read it before installing."
   ""
   "(defpackage #:nodecode-{{slug}}"
   "  (:use #:cl)"
   "  (:nicknames #:{{slug}})"
   "  (:export #:start-cell #:stop-cell #:new-files #:run-command))"
   ""
   "(in-package #:nodecode-{{slug}})"
   ""
   "(nlk:define-peripheral {{slug}} :not-running t)"
   ""
   "(defparameter *state* (nlk:home \"{{slug}}/seen.txt\")"
   "  \"The file names already reported, one a line.\")"
   ""
   "(defun expand-home (text)"
   "  \"TEXT, with a leading ~ read as this user's home directory.\""
   "  (if (and (plusp (length text)) (char= #\\~ (char text 0)))"
   "      (merge-pathnames (subseq text (min 2 (length text))) (user-homedir-pathname))"
   "      (pathname text)))"
   ""
   "(defun known ()"
   "  \"The names reported earlier.\""
   "  (if (probe-file *state*) (uiop:read-file-lines *state*) '()))"
   ""
   "(defun remember (names)"
   "  (ensure-directories-exist *state*)"
   "  (with-open-file (out *state* :direction :output :if-exists :append"
   "                             :if-does-not-exist :create)"
   "    (dolist (name names) (write-line name out))))"
   ""
   "(defun candidates ()"
   "  \"The files of the watched type in the folder.\""
   "  (let ((folder (uiop:ensure-directory-pathname (expand-home (setting :folder)))))"
   "    (remove-if-not (lambda (file)"
   "                     (string-equal (or (pathname-type file) \"\") \"{{ext}}\"))"
   "                   (ignore-errors (uiop:directory-files folder)))))"
   ""
   "(defun new-files ()"
   "  \"The watched files no earlier call reported, remembered as reported now.\""
   "  (let* ((known (known))"
   "         (fresh (remove-if (lambda (file)"
   "                             (member (file-namestring file) known :test #'string=))"
   "                           (candidates))))"
   "    (when fresh (remember (mapcar #'file-namestring fresh)))"
   "    fresh))"
   ""
   "(nlk:define-contract {{slug}}-scan"
   "  (:doc \"Report the {{ext}} files in {{source-name}} that are new since the last"
   "call, and remember them as reported.\")"
   "  (\"limit\" :integer :default {{limit}} :min 1 :doc \"how many names to report at most\"))"
   ""
   "(defun scan-tool (record)"
   "  \"The {{tool}} tool: the new file names.\""
   "  (let ((names (mapcar #'file-namestring (new-files))))"
   "    (if (null names)"
   "        (format nil \"Nothing new in {{source-name}}.\")"
   "        (format nil \"~d new {{ext}} file~:p in {{source-name}}: ~{~a~^, ~}\""
   "                (length names)"
   "                (subseq names 0 (min (length names) ({{slug}}-scan-limit record)))))))"
   ""
   "(defun run-command (args session-id)"
   "  \"The /{{slug}} command: the names new since the last look.\""
   "  (declare (ignore args session-id))"
   "  (let ((names (mapcar #'file-namestring (new-files))))"
   "    (if names"
   "        (format nil \"~d new {{ext}} file~:p in {{source-name}}:~%~{- ~a~%~}\""
   "                (length names) names)"
   "        (format nil \"Nothing new in {{source-name}}.\"))))"
   ""
   "(defun step ()"
   "  \"What the worker does each interval: say how many are new, once.\""
   "  (let ((names (new-files)))"
   "    (when names"
   "      (nle:notice (format nil \"{{slug}}: ~d new {{ext}} file~:p in {{source-name}}\""
   "                          (length names))"
   "                  :key \"{{slug}}\")))"
   "  nil)"
   ""
   "(defparameter +manual+"
   "  \"{{slug}}: the {{ext}} files in {{source-name}} that no call has reported yet."
   "(nodecode-{{slug}}:new-files)   the new names, and they count as reported"
   "The {{tool}} tool and /{{slug}} report the names new since the last report. A"
   "worker looks every interval_minutes and says in a notice how many there are; it"
   "starts no process and reaches no network.\")"
   ""
   "(nle:define-cell {{slug}}"
   "  (:section (\"{{slug}}\")"
   "    (:guide \"folder is where it looks, a ~ or a path; the type is fixed at {{ext}};"
   "/{{slug}} reports what is new\")"
   "    (\"folder\" :string :default \"{{source}}\" :doc \"the folder watched\")"
   "    (\"interval_minutes\" :integer :default {{interval}} :min 1"
   "     :doc \"how often the worker looks for itself\"))"
   "  (:tool \"{{tool}}\" (nlk:contract '{{slug}}-scan) #'scan-tool)"
   "  (:help :{{slug}} \"{{slug}}: new {{ext}} files in {{source-name}}\" +manual+)"
   "  (:command \"{{slug}}\" #'run-command"
   "            :description \"Report the {{ext}} files new since the last report\")"
   "  (:start (lambda ()"
   "            (nlk:worker-start \"{{slug}}\" #'step"
   "                              :wake (* 60 (setting :interval-minutes))))))")
  "The folder watcher: one tool, one command, one worker, a text state file.")

;;; --- the JSON API poller -------------------------------------------------------

(defparameter *poller-cell*
  (text-lines
   ";;;; cell.lisp --- new items from {{source-name}}, as a tool and /{{slug}}."
   ";;;;"
   ";;;; SPDX-License-Identifier: MIT"
   ";;;;"
   ";;;; Written by the foundry cell for one request: read it before installing."
   ""
   "(defpackage #:nodecode-{{slug}}"
   "  (:use #:cl)"
   "  (:nicknames #:{{slug}})"
   "  (:export #:start-cell #:stop-cell #:new-items #:run-command))"
   ""
   "(in-package #:nodecode-{{slug}})"
   ""
   "(nlk:define-peripheral {{slug}} :not-running t)"
   ""
   "(defparameter *state* (nlk:home \"{{slug}}/seen.txt\")"
   "  \"The item identities already reported, one a line.\")"
   ""
   "(defun known ()"
   "  (if (probe-file *state*) (uiop:read-file-lines *state*) '()))"
   ""
   "(defun remember (keys)"
   "  (ensure-directories-exist *state*)"
   "  (with-open-file (out *state* :direction :output :if-exists :append"
   "                             :if-does-not-exist :create)"
   "    (dolist (key keys) (write-line key out))))"
   ""
   "(defun items-of (body)"
   "  \"The items a JSON answer carries: the array itself, or the array under"
   "items, results or data.\""
   "  (let ((data (ignore-errors (nlk:decode-json body))))"
   "    (cond ((vectorp data) data)"
   "          ((hash-table-p data)"
   "           (or (gethash \"items\" data) (gethash \"results\" data)"
   "               (gethash \"data\" data) #()))"
   "          (t #()))))"
   ""
   "(defun identity-of (item)"
   "  \"What makes ITEM the same item next time: its id, url or number.\""
   "  (if (hash-table-p item)"
   "      (or (gethash \"id\" item) (gethash \"guid\" item) (gethash \"url\" item)"
   "          (gethash \"html_url\" item) (gethash \"number\" item) (gethash \"title\" item))"
   "      item))"
   ""
   "(defun title-of (item)"
   "  \"One line naming ITEM.\""
   "  (if (hash-table-p item)"
   "      (or (gethash \"title\" item) (gethash \"name\" item) (gethash \"url\" item)"
   "          (princ-to-string (identity-of item)))"
   "      (princ-to-string item)))"
   ""
   "(defun new-items ()"
   "  \"The items {{source-name}} answers that no earlier call reported, remembered.\""
   "  (multiple-value-bind (body status) (nlk:http :get (setting :url) :timeout 20)"
   "    (unless (and body (integerp status) (< status 400))"
   "      (fail \"~a answered ~a\" (setting :url) status))"
   "    (let* ((known (known))"
   "           (fresh (remove-if (lambda (item)"
   "                               (member (princ-to-string (identity-of item)) known"
   "                                       :test #'string=))"
   "                             (coerce (items-of body) 'list))))"
   "      (when fresh (remember (mapcar (lambda (item) (princ-to-string (identity-of item)))"
   "                                     fresh)))"
   "      fresh)))"
   ""
   "(nlk:define-contract {{slug}}-poll"
   "  (:doc \"Report the items {{source-name}} has that were not reported before, and"
   "remember them.\")"
   "  (\"limit\" :integer :default {{limit}} :min 1 :doc \"how many items to report at most\"))"
   ""
   "(defun poll-tool (record)"
   "  \"The {{tool}} tool: the new items, one a line.\""
   "  (let* ((items (new-items))"
   "         (shown (subseq items 0 (min (length items) ({{slug}}-poll-limit record)))))"
   "    (if (null shown)"
   "        (format nil \"Nothing new at {{source-name}}.\")"
   "        (format nil \"~d new item~:p at {{source-name}}:~%~{- ~a~%~}\""
   "                (length items) (mapcar #'title-of shown)))))"
   ""
   "(defun run-command (args session-id)"
   "  \"The /{{slug}} command: the items new since the last look.\""
   "  (declare (ignore args session-id))"
   "  (let ((items (new-items)))"
   "    (if items"
   "        (format nil \"~d new item~:p at {{source-name}}:~%~{- ~a~%~}\""
   "                (length items) (mapcar #'title-of items))"
   "        (format nil \"Nothing new at {{source-name}}.\"))))"
   ""
   "(defun step ()"
   "  \"What the worker does each interval: say how many are new, once.\""
   "  (handler-case"
   "      (let ((items (new-items)))"
   "        (when items"
   "          (nle:notice (format nil \"{{slug}}: ~d new item~:p at {{source-name}}\""
   "                              (length items))"
   "                      :key \"{{slug}}\")))"
   "    (error (condition)"
   "      (nle:notice (format nil \"{{slug}}: ~a\" condition) :level :warning :key \"{{slug}}\")))"
   "  nil)"
   ""
   "(defparameter +manual+"
   "  \"{{slug}}: the items {{source-name}} lists that no call has reported yet."
   "(nodecode-{{slug}}:new-items)   the new items, and they count as reported"
   "The {{tool}} tool and /{{slug}} report the items new since the last report, by the"
   "id, url or number each item carries. A worker asks every interval_minutes and says"
   "in a notice how many there are; it reads one URL and nothing else.\")"
   ""
   "(nle:define-cell {{slug}}"
   "  (:section (\"{{slug}}\")"
   "    (:guide \"url is the JSON endpoint; /{{slug}} reports what is new; interval_minutes"
   "is how often the worker asks\")"
   "    (\"url\" :string :default \"{{source}}\" :doc \"the JSON endpoint polled\")"
   "    (\"interval_minutes\" :integer :default {{interval}} :min 1"
   "     :doc \"how often the worker asks\"))"
   "  (:tool \"{{tool}}\" (nlk:contract '{{slug}}-poll) #'poll-tool)"
   "  (:help :{{slug}} \"{{slug}}: new items at {{source-name}}\" +manual+)"
   "  (:command \"{{slug}}\" #'run-command"
   "            :description \"Report the items new since the last report\")"
   "  (:start (lambda ()"
   "            (nlk:worker-start \"{{slug}}\" #'step"
   "                              :wake (* 60 (setting :interval-minutes))))))")
  "The API poller: one tool, one command, one worker, a text state file.")
