// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config. The declaration in cell.lisp is the authority;
// this is an illustration of it. A present section is enabled; "enabled":
// false vetoes it. Nothing here is a secret: the station's token is read
// from its own data folder.
{
  "myradio": {
    "enabled": true,
    "data_dir": "~/.myradio",
    "port": 8765,
    "timeout_seconds": 15
  }
}
