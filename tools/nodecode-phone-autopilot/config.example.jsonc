// The section ~/.nodecode/config.jsonc may carry for this peripheral —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
{
  "phone-autopilot": {
    "enabled": true,
    "command": "phone-harness",        // or "uvx phone-harness", "python3 -m phone_harness.run"
    "directory": "phone-autopilot",    // routines and their runs, relative to ~/.nodecode
    "approve": true,                   // ask before code is saved or run
    "ask_before_apps": false,          // keep a run out of apps not in allowed_apps
    "allowed_apps": ["com.spotify.music"],
    "timeout_seconds": 300             // the default bound for one run, 1 to 900
  }
}
