// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
{
  "memoria": {
    "enabled": true,
    "api_key": "sk-...",        // the memory-service API key, not the website's session token
    "api_url": "https://api.thememoria.ai",
    "branch": "main",
    "top_k": 5,
    "context_chars": 6000,
    "auto_recall": true,
    "timeout_seconds": 15
  }
}
