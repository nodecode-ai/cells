// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. The declaration in cell.lisp is the authority.
{
  "game-editor": {
    "enabled": true,
    // The Godot project folder: the one that holds project.godot.
    "project": "~/projects/lantern-run",
    // How many rows or lines one read answers with, unless the call asks for fewer.
    "read_lines": 200,
    // How many characters one answer carries; a longer one says how much it left.
    "read_chars": 6000
  }
}
