// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder is pushed, so no key lives here.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
//
// The key is an EquipDash API key made under Settings > API & Integrations
// with the mcp:access scope, named here rather than pasted in. A person who
// signed in to the same server in /mcp needs no key at all: the shipped mcp
// cell keeps that sign-in and this cell reuses it.
{
  "equipdash": {
    "enabled": true,
    "server_url": "https://app.equipdash.com/mcp/v1",
    "token_env": "EQUIPDASH_API_KEY",
    "timeout_seconds": 30,
    "max_chars": 12000
  }
}
