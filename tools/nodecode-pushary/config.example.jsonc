// The section ~/.nodecode/config.jsonc may carry for this cell: documentation,
// not config — the folder is public and holds no secret. The declaration in
// cell.lisp is the authority; this is an illustration of it. A present
// section is enabled; "enabled": false vetoes it.
{
  "pushary": {
    "enabled": true,
    "api_key_env": "PUSHARY_API_KEY",
    "base_url": "https://pushary.com",
    "agent_name": "Nodecode",
    "timeout": 20
  }
}
