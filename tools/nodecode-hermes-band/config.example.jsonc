// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. Nothing here is a secret: the render is local.
{
  "hermes-band": {
    "enabled": true,

    // Where rendered tracks are written, one subfolder per track.
    "output_dir": "hermes-band-out/",

    // A General MIDI .sf2. Left empty, the usual system locations are
    // searched (fluid-soundfont-gm, FluidR3_GM.sf2 and friends).
    "soundfont": "",

    // The binaries, as they are on PATH.
    "fluidsynth": "fluidsynth",
    "ffmpeg": "ffmpeg",

    // The render's sample rate.
    "sample_rate": 44100,

    // The loudness target for a render that names none, in LUFS.
    "lufs": -14
  }
}
