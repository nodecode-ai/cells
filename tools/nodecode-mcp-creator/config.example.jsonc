// The `mcp-creator` section ~/.nodecode/config.jsonc may carry — documentation,
// not config: the folder gets pushed and holds no secret. The declaration in
// cell.lisp is the authority; this shows every member and what it changes.
// A present section is enabled; "enabled": false vetoes it.
{
  "mcp-creator": {
    "enabled": true,
    // where snapshots, builds and calls.jsonl live (default: this home's mcp-creator folder)
    "data_dir": "/home/you/.nodecode/mcp-creator",
    // where install copies a build (default: this home's cells folder)
    "install_dir": "/home/you/.nodecode/cells",
    // one exchange with a server, in seconds
    "timeout_seconds": 60,
    // characters kept per tool description in the generated skill
    "max_desc": 220,
    // record the MCP calls the model makes, redacted and local, for usage mining
    "log_calls": true
  }
}
