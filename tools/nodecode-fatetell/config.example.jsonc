// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
//
// No token is needed for chart casting and the almanac. A FateTell account
// opens the saved charts, the judgment, the daily fortune, the calendar and
// saving: sign in through FateTell, take the OAuth access token, and write it
// here (kept in a 0600 file by Nodecode) or name the variable that holds it.
{
  "fatetell": {
    "enabled": true,
    "mcp_url": "https://mcp.fatetell.com/mcp",
    "access_token_env": "FATETELL_ACCESS_TOKEN",
    "timeout_seconds": 60,
    "initialize": true
  }
}
