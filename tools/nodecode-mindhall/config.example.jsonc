// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret. The
// declaration in cell.lisp is the authority; this is an illustration of it.
{
  "mindhall": {
    "enabled": true,
    "store": "~/.mindhall/mindhall.json",
    "agent": "Nodecode",
    "inject": true,
    "max_chars": 1800,
    "block_changes": 5,
    "days_ahead": 14,
    "max_text": 500
  }
}
