// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "agentvault": {
    "enabled": true,
    // the binding token Agent Vault issued for this client: 64 hex characters
    "token": "…",
    // the client binding the token belongs to: hermes, cursor, codex, claude-code
    "client": "hermes",
    "app_path": "/Applications/Agent Vault.app",
    // empty means the app's own default home for the archive
    "vault_home": "",
    "timeout_seconds": 30
  }
}
