// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// A present section is enabled; "enabled": false vetoes it.
{
  "dsers": {
    // The account's DSers MCP server; the service's own by default.
    "endpoint": "https://ai.dsers.com/mcp",
    // The token is named, never written here: an environment variable, or
    // "token" written inline. It comes from the service's OAuth sign-in.
    "token_env": "DSERS_MCP_TOKEN",
    // One exchange's ceiling, in seconds.
    "timeout_seconds": 60
  }
}
