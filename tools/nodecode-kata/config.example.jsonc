// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration.
// A present section is enabled; "enabled": false vetoes it.
{
  "kata": {
    "enabled": true,
    // record the tool calls a turn runs, in memory, masked
    "record": true,
    // how many recent calls the record keeps
    "history": 200,
    // a routine is at most this many steps long
    "max_steps": 6,
    // and must repeat in at least this many separate sessions
    "min_support": 2
  }
}
