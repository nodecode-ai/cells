// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "pethost": {
    // The name, never the secret: export the MCP connection's access token in
    // the shell that starts Nodecode.
    "token_env": "PETHOST_TOKEN",
    // Or a file whose first line is the token.
    // "token_file": "~/.pethost-token",
    // Pethost's own server, over streamable HTTP.
    "url": "https://mcp.pethost.dev/mcp",
    // A deploy call waits for the deploy: keep this generous.
    "timeout": 120
  }
}
