// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it. Every
// member is optional: with no section at all, all 71 formats are masked.
{
  "redaction-pack": {
    "enabled": true,
    "vendors": ["HashiCorp Vault", "Doppler", "Tailscale"],
    "style": "ends"
  }
}
