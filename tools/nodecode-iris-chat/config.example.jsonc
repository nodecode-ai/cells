// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "iris-chat": {
    "enabled": true,
    // the iris program: its name on PATH, or a path to it
    "iris": "iris",
    // the profile directory this identity lives in; empty uses the program's
    // own default. One directory per identity, never a person's own profile.
    "data_dir": "~/.local/share/iris-agent",
    // say at a turn's first request how many messages wait unread
    "notify": true,
    // the longest answer one tool hands the model, in characters
    "max_chars": 4000
  }
}
