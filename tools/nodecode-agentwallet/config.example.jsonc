// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// A present section is enabled; "enabled": false vetoes it.
{
  "agentwallet": {
    "enabled": true,

    // The agent key from openclawcash.com. A pasted key is kept in a 0600
    // file under ~/.nodecode/secrets/ and this section is pointed at that
    // file instead.
    "agent_key": "occ_...",

    // Or the name of the environment variable holding it.
    // OPENCLAWCASH_AGENT_KEY is read either way, so an exported key needs no
    // section at all.
    "agent_key_env": "OPENCLAWCASH_AGENT_KEY",

    // Only for another host under openclawcash.com; the key is refused any
    // other host.
    // "base_url": "https://openclawcash.com",

    // Where wallet creation reads its export passphrase (12+ characters).
    // The variable, never the passphrase, stands here.
    "export_passphrase_env": "OPENCLAWCASH_EXPORT_PASSPHRASE",

    // One API call's ceiling, in seconds.
    "timeout_seconds": 30
  }
}
