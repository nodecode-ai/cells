// The section ~/.nodecode/config.jsonc may carry for this peripheral —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority. A present section is
// enabled; "enabled": false vetoes it.
{
  "obol": {
    "enabled": true,
    "api_key": "sk_test_your_key_here",
    "allow_live": false,
    "default_currency": "usd",
    "days_until_due": 14,
    "timeout_seconds": 20
  }
}
