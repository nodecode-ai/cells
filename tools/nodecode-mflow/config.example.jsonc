// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority. A present section is
// enabled; "enabled": false vetoes it. A token is required, one of the two
// ways below.
{
  "mflow": {
    "token_env": "MFLOW_TOKEN",                   // the variable holding a Personal Access Token, or "token" inline
    "endpoint": "https://mcp.m-flow.io/mcp",       // mFlow's MCP endpoint, or a proxy of your own
    "timeout_seconds": 120                          // one call's ceiling
  }
}
