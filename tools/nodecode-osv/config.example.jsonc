// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret,
// and none is needed. The declaration in cell.lisp is the authority; this
// is an illustration of it. A present section is enabled;
// "enabled": false vetoes it.
{
  "osv": {
    "enabled": true,
    "max_chars": 4000,
    "timeout_seconds": 10,
    "alias_lookups": 4
  }
}
