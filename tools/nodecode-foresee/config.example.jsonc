// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this illustrates it.
// Nothing here is required: Foresee's own server needs no key.
{
  "foresee": {
    "enabled": true,
    "endpoint": "https://agents.go-foresee.com/mcp",
    "timeout_seconds": 120,
    "max_chars": 6000
  }
}
