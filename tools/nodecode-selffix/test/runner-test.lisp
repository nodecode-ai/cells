;;;; runner-test.lisp --- the sealed argv, the score line, the verdicts, and locating over generations.

(in-package #:nodecode.test)

(deftest selffix-cell-runner-sealed-command ()
  (let* ((argv (nodecode-selffix::sealed-command #p"/opt/nc/1/nodecode" #p"/x/selffix/scratch/a/" :hide '("/x" "/data/u")))
         (set (loop for (word name) on argv when (equal word "--setenv") collect name)))
    (is (equal "bwrap" (first argv)))
    (is (member "--unshare-all" argv :test #'equal) "every namespace unshared, the network with them")
    (is (member "--clearenv" argv :test #'equal) "the parent's environment, keys with it, is cleared")
    (is (equal '("PATH" "LANG" "HOME" "NODECODE_HOME" "XDG_CACHE_HOME" "XDG_CONFIG_HOME" "XDG_DATA_HOME") set))
    (is (search '("--bind" "/x/selffix/scratch/a" "/x/selffix/scratch/a") argv :test #'equal) "only the throwaway home is writable")
    (is (search '("--tmpfs" "/home") argv :test #'equal) "the real home is hidden")
    (is (< (search '("--tmpfs" "/x") argv :test #'equal) (search '("--bind" "/x/selffix/scratch/a") argv :test #'equal)) "the organism's home is hidden, then the throwaway home under it bound back")
    (is (search '("--tmpfs" "/data/u") argv :test #'equal) "a home outside /home is hidden too")
    (is (equal '("/opt/nc/1/nodecode" "trial") (last argv 2)))))

(deftest selffix-cell-runner-score-line ()
  (is (eql 1 (nodecode-selffix::score-of (format nil "noise~%nodecode-trial-score 1~%"))))
  (is (eql 0 (nodecode-selffix::score-of (format nil "nodecode-trial-score 1~%nodecode-trial-score 0~%"))) "the last marked line")
  (is (null (nodecode-selffix::score-of "nodecode-trial-score #.(boom)")) "read with *read-eval* off")
  (is (null (nodecode-selffix::score-of "no score"))))

(deftest selffix-cell-runner-verdicts ()
  (with-selffix-root ()
    (loop for (score verdict) in '((1 :stands) (0 :gone) (2 :undecided) (-1 :unknown) (nil :unknown))
          do (let ((seen nil))
               (let ((nodecode-selffix::*lay* (lambda (number home) (declare (ignore number)) (setf seen home)))
                     (nodecode-selffix::*ask* (lambda (text home) (declare (ignore text home)) (values score "stubbed"))))
                 (is (eq verdict (nodecode-selffix::ask-at "(+ 0 1)" 3)))
                 (is (not (probe-file seen)) "the throwaway home is removed"))))
    (let ((guarded (let ((*package* (find-package '#:nodecode-selffix)))
                     (read-from-string (nodecode-selffix::guarded "(+ 0 1)")))))
      (is (equal '(handler-case (+ 0 1) (error () -1)) guarded) "a repro that signals answers -1, never 0"))))

(defvar *selffix-laid* nil)

(defun selffix-locate (broken-from numbers &key (probes 6))
  "Locate over NUMBERS where the failure stands from BROKEN-FROM on => (values RESULT ASKS)."
  (let ((asks (list 0)))
    (with-selffix-root ()
      (let ((nodecode-selffix::*locate-probes* probes)
            (nodecode-selffix::*lay* (lambda (number home) (declare (ignore home)) (setf *selffix-laid* number)))
            (nodecode-selffix::*ask* (lambda (text home) (declare (ignore text home))
                                       (incf (car asks))
                                       (values (if (>= *selffix-laid* broken-from) 1 0) "stubbed"))))
        (values (nodecode-selffix::locate "(+ 0 1)" numbers) (car asks))))))

(deftest selffix-cell-runner-locate ()
  (let ((numbers (loop for n from 1 to 40 collect n)))
    (multiple-value-bind (found asks) (selffix-locate 27 numbers)
      (is (equal '(:gone-at 26 :stands-at 27) found) "the step where it turned from gone to standing")
      (is (<= asks 7) "halving, within the probes"))
    (is (equal '(:stands-since 1) (selffix-locate 1 numbers)) "standing at the oldest: no step to name")
    (is (null (selffix-locate 27 numbers :probes 2)) "out of probes: says nothing rather than guess")
    (is (null (selffix-locate 1 '(5))) "one generation: nothing to search")))
