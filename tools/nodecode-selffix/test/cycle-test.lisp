;;;; cycle-test.lisp --- one observe cycle end to end over stubs, the verb, the wake source.

(in-package #:nodecode.test)

(defmacro with-selffix-cycle ((&key items (busy nil) (repro '(selffix-repro-stub))) &body body)
  `(with-selffix-root ()
     (let ((nodecode-selffix::*backlog* (lambda (&key limit) (declare (ignore limit)) ,items))
           (nodecode-selffix::*busy* (lambda (now idle) (declare (ignore now idle)) ,busy))
           (nodecode-selffix::*repro* ,repro))
       ,@body)))

(defun selffix-cycle () (nodecode-selffix::cycle :idle-seconds 1800))

(deftest selffix-cell-cycle-finding ()
  (let ((item (selffix-item "NO-APPLICABLE-METHOD-ERROR in render 42" :count 8)))
    (with-selffix-cycle (:items (list item))
      (multiple-value-bind (status detail) (selffix-cycle)
        (is (eq :finding status))
        (is (search "seen 8 times" detail)))
      (let* ((fp (nodecode-selffix::fingerprint item))
             (dir (nodecode-selffix::finding-dir fp))
             (row (first (nodecode-selffix::findings (nodecode-selffix::ledger-rows)))))
        (is (probe-file (merge-pathnames "finding.md" dir)) "the finding is written")
        (is (equal (nodecode-selffix::file-sha256 (merge-pathnames "repro-test.lisp" dir))
                   (nodecode-selffix::row row "sha256"))
            "the test copy is locked by its hash in the ledger")
        (is (search "test locked" (nodecode-selffix::selffix :findings))))
      (is (eq :nothing (selffix-cycle)) "a found item is not found again")
      (is (not (probe-file (nodecode-selffix::lock-path))) "the lock is dropped after a cycle"))))

(deftest selffix-cell-cycle-gates-cost-nothing ()
  (let ((calls (list 0)))
    (with-selffix-cycle (:items (list (selffix-item "x")) :busy "a turn in s-work was at work 5s ago"
                         :repro (selffix-repro-stub :calls calls))
      (is (eq :busy (selffix-cycle)) "a busy home skips")
      (is (= 0 (car calls)) "and nothing ran"))
    (with-selffix-cycle (:items (list (selffix-item "x")) :repro (selffix-repro-stub :calls calls))
      (nodecode-selffix::record "stopped" :by "s-op")
      (is (eq :stopped (selffix-cycle)))
      (is (= 0 (car calls)) "a stop holds before any work"))
    (with-selffix-cycle (:items (list (selffix-item "x")) :repro (selffix-repro-stub :calls calls))
      (nodecode-selffix::take-lock (get-universal-time))
      (is (eq :locked (selffix-cycle)) "a held lock skips")
      (is (= 0 (car calls))))))

(deftest selffix-cell-cycle-drops-and-pauses ()
  (let ((item (selffix-item "flaky thing")))
    (with-selffix-cycle (:items (list item) :repro (selffix-repro-stub :fails nil))
      (dotimes (i 3) (is (eq :not-reproduced (selffix-cycle))))
      (is (eq :nothing (selffix-cycle)) "the fourth cycle drops it")
      (is (find "dropped" (nodecode-selffix::ledger-rows)
                :key (lambda (r) (nodecode-selffix::row r "outcome")) :test #'equal))
      (is (eq :nothing (selffix-cycle)) "and it stays dropped")))
  (with-selffix-cycle (:items (list (selffix-item "a") (selffix-item "b") (selffix-item "c") (selffix-item "d"))
                       :repro (selffix-repro-stub :error "the throwaway home did not start"))
    (dotimes (i 3) (is (eq :failed (selffix-cycle))))
    (multiple-value-bind (status detail) (selffix-cycle)
      (is (eq :paused status) "three failed cycles in a row pause the loop")
      (is (search "3 failed" detail)))))

(deftest selffix-cell-cycle-stop-sticks ()
  (with-selffix-cycle ()
    (let ((nlk:*scribe-session-id* "s-op"))
      (nodecode-selffix::selffix :off))
    (let ((nlk:*scribe-session-id* "cron-wake-1"))
      (is (handler-case (progn (nodecode-selffix::selffix :on) nil) (error () t))
          "a cron job's session may not lift the stop"))
    (is (eq :stopped (selffix-cycle)) "the stop still holds")
    (let ((nlk:*scribe-session-id* "s-op"))
      (nodecode-selffix::selffix :on))
    (is (eq :nothing (selffix-cycle)) "the operator's start lifts it")))

(deftest selffix-cell-wake-source-registered ()
  (with-selffix-root ()
    (with-cell-stop ((selffix-start "idle_minutes" 30))
      (is (member 'nodecode-selffix::wake-source nodecode-cron::*wake-sources*)
          "a started cell is a wake source"))
    (is (not (member 'nodecode-selffix::wake-source nodecode-cron::*wake-sources*))
        "a stopped one is not")))
