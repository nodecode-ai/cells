;;;; cycle-test.lisp --- one observe cycle end to end over stubs, the verb, the wake source.

(in-package #:nodecode.test)

(defmacro with-selffix-cycle ((&key items (busy nil) (answer 1) (calls '(list 0)) error) &body body)
  `(with-selffix-root ()
     (let ((nodecode-selffix::*backlog* (lambda (&key limit fixable) (declare (ignore limit fixable)) ,items))
           (nodecode-selffix::*busy* (lambda (now idle) (declare (ignore now idle)) ,busy)))
       (with-selffix-runner (:answer ,answer :calls ,calls :error ,error)
         ,@body))))

(defun selffix-cycle () (nodecode-selffix::cycle :idle-seconds 1800))

(defun selffix-wait (thread &key (seconds 30))
  "Wait, at most SECONDS, until THREAD has ended."
  (loop with deadline = (+ (get-universal-time) seconds)
        while (and thread (bt2:thread-alive-p thread) (< (get-universal-time) deadline))
        do (sleep 0.05)))

(deftest selffix-cell-cycle-finding ()
  (let ((item (selffix-item "NO-APPLICABLE-METHOD-ERROR in render 42" :count 8)))
    (with-selffix-cycle (:items (list item))
      (multiple-value-bind (status detail) (selffix-cycle)
        (is (eq :finding status))
        (is (search "seen 8 times" detail)))
      (let* ((fp (nodecode-selffix::fingerprint item))
             (path (nodecode-selffix::finding-file fp))
             (row (first (nodecode-selffix::findings (nodecode-selffix::ledger-rows))))
             (commit (nodecode-selffix::row row "commit")))
        (is (probe-file path) "the finding is one .lisp file")
        (is (= 40 (length commit)) "the ledger keeps the finding's commit")
        (is (equal "(+ 0 1)" (nodecode-selffix::locked-repro fp commit)) "the commit holds the repro")
        (let ((finding (with-standard-io-syntax
                         (let ((*read-eval* nil) (*package* (find-package '#:keyword)))
                           (with-open-file (in path) (read in))))))
          (is (getf finding :located) "the finding says where in the generations it turned"))
        (is (search "repro locked at" (nodecode-selffix::selffix :findings)))
        (is (= 1 (nodecode-selffix::reproduce path)) "the committed repro, asked again, still stands")
        (with-open-file (out path :direction :output :if-exists :append)
          (write-line "(:repro \"0\")" out))
        (is (search "changed since its commit" (nodecode-selffix::selffix :findings)) "an edit shows")
        (is (equal "(+ 0 1)" (nodecode-selffix::locked-repro fp commit)) "and the lock still reads the committed repro"))
      (is (eq :nothing (selffix-cycle)) "a found item is not found again")
      (is (prog1 (nodecode-selffix::take-lock) (nodecode-selffix::drop-lock)) "the lock is dropped after a cycle"))))

(deftest selffix-cell-wake-source-leaves-the-ticker ()
  (let ((gate (sb-thread:make-semaphore))
        (since (- (get-universal-time) 5)))
    (with-selffix-cycle (:items (list (selffix-item "slow" :count 4)))
      (let ((nodecode-selffix::*ask* (lambda (text home)
                                       (declare (ignore text home))
                                       (sb-thread:wait-on-semaphore gate :timeout 5)
                                       (values 1 "stubbed")))
            (nodecode-selffix::*async* t))
        (with-cell-stop ((selffix-start "idle_minutes" 30))
          (let ((started (get-internal-real-time)))
            (is (null (nodecode-selffix::wake-source since)) "nothing found yet")
            (is (< (- (get-internal-real-time) started) internal-time-units-per-second) "the wake returns while the repro runs"))
          (let ((first nodecode-selffix::*cycle-thread*))
            (is (null (nodecode-selffix::wake-source since)))
            (is (eq first nodecode-selffix::*cycle-thread*) "a wake while a cycle runs starts no second one")
            (sb-thread:signal-semaphore gate 20)
            (selffix-wait first))
          (let ((news (nodecode-selffix::wake-source since)))
            (is (search "selffix found" (first news)) "the next wake says the finding, from the ledger")
            (selffix-wait nodecode-selffix::*cycle-thread*)
            (is (equal news (nodecode-selffix::wake-source since)) "a skipped wake loses nothing")
            (is (null (nodecode-selffix::wake-source (get-universal-time))) "a cursor past it says it no more")
            (selffix-wait nodecode-selffix::*cycle-thread*)))))))

(deftest selffix-cell-cycle-could-not-run-is-a-failure ()
  (with-selffix-cycle (:items (list (selffix-item "x")) :answer nil)
    (multiple-value-bind (status detail) (selffix-cycle)
      (is (eq :failed status) "an unsealed or unstarted run is never a finding or a pass")
      (is (search "stubbed" detail)))))

(deftest selffix-cell-cycle-gates-cost-nothing ()
  (let ((calls (list 0)))
    (with-selffix-cycle (:items (list (selffix-item "x")) :busy "a turn in s-work was at work 5s ago"
                         :calls calls)
      (is (eq :busy (selffix-cycle)) "a busy home skips")
      (is (= 0 (car calls)) "and nothing ran"))
    (with-selffix-cycle (:items (list (selffix-item "x")) :calls calls)
      (nodecode-selffix::record "stopped" :by "s-op")
      (is (eq :stopped (selffix-cycle)))
      (is (= 0 (car calls)) "a stop holds before any work"))
    (with-selffix-cycle (:items (list (selffix-item "x")) :calls calls)
      (nodecode-selffix::take-lock)
      (is (eq :locked (selffix-cycle)) "a held lock skips")
      (is (= 0 (car calls))))))

(deftest selffix-cell-cycle-drops-and-pauses ()
  (let ((item (selffix-item "flaky thing")))
    (with-selffix-cycle (:items (list item) :answer 0)
      (dotimes (i 3) (is (eq :not-reproduced (selffix-cycle))))
      (is (eq :nothing (selffix-cycle)) "the fourth cycle drops it")
      (is (find "dropped" (nodecode-selffix::ledger-rows)
                :key (lambda (r) (nodecode-selffix::row r "outcome")) :test #'equal))
      (is (eq :nothing (selffix-cycle)) "and it stays dropped")))
  (with-selffix-cycle (:items (list (selffix-item "a") (selffix-item "b") (selffix-item "c") (selffix-item "d"))
                       :error "the throwaway home did not start")
    (dotimes (i 3) (is (eq :failed (selffix-cycle))))
    (multiple-value-bind (status detail) (selffix-cycle)
      (is (eq :paused status) "three failed cycles in a row pause the loop")
      (is (search "3 failed" detail)))))

(deftest selffix-cell-wake-source-pause-is-news-once ()
  (with-selffix-cycle (:items (list (selffix-item "a") (selffix-item "b") (selffix-item "c") (selffix-item "d"))
                       :error "the throwaway home did not start")
    (with-cell-stop ((selffix-start "idle_minutes" 30))
      (let* ((cursor (get-universal-time))
             (news (loop repeat 6
                         collect (let ((lines (nodecode-selffix::wake-source cursor)))
                                   (when lines (setf cursor (get-universal-time)))
                                   lines))))
        (is (and (null (first news)) (null (second news))) "a single failed cycle buys no wake turn")
        (is (search "paused: 3 failed" (first (third news))) "the failure that trips the breaker is news")
        (is (every #'null (nthcdr 3 news)) "a held pause stays quiet, so the wake backs off at $0")))))

(deftest selffix-cell-cycle-stop-sticks ()
  (with-selffix-cycle ()
    (let ((nlk:*scribe-session-id* "s-op"))
      (nodecode-selffix::selffix :off))
    (let ((nlk:*scribe-session-id* "cron-wake-1"))
      (is (handler-case (progn (nodecode-selffix::selffix :on) nil) (error () t))))
    (is (eq :stopped (selffix-cycle)) "the stop still holds")
    (let ((nlk:*scribe-session-id* "s-op"))
      (nodecode-selffix::selffix :on))
    (is (eq :nothing (selffix-cycle)) "the operator's start lifts it")))

(deftest selffix-cell-wake-source-registered ()
  (with-selffix-root ()
    (with-cell-stop ((selffix-start "idle_minutes" 30))
      (is (member 'nodecode-selffix::wake-source nodecode-cron::*wake-sources*) "a started cell is a wake source"))
    (is (not (member 'nodecode-selffix::wake-source nodecode-cron::*wake-sources*)) "a stopped one is not")))
