;;;; ledger-test.lisp --- fingerprints, the breakers, which items may run, the stop.

(in-package #:nodecode.test)

(deftest selffix-cell-ledger-normalize-key ()
  (is (equal "error at <path>:# in turn-<id>-<id>"
             (nodecode-selffix::normalize-key "Error at /home/vise/x.lisp:12 in turn-1U72XJX-1BJTDKOXGE"))
      "paths, ids that mix letters and digits, and numbers read alike")
  (is (equal "no-applicable-method-error on wake-call-refusal"
             (nodecode-selffix::normalize-key "NO-APPLICABLE-METHOD-ERROR  on WAKE-CALL-REFUSAL"))
      "a function name without digits stays as it is"))

(deftest selffix-cell-ledger-fingerprint ()
  (let ((a (nodecode-selffix::fingerprint (selffix-item "timed out after 12 s in /tmp/a")))
        (b (nodecode-selffix::fingerprint (selffix-item "timed out after 9 s in /tmp/b")))
        (c (nodecode-selffix::fingerprint (selffix-item "timed out after 9 s in /tmp/b" :source "qa"))))
    (is (= 16 (length a)))
    (is (equal a b) "two sightings of one failure share a fingerprint")
    (is (not (equal b c)) "the source is part of it")))

(deftest selffix-cell-ledger-breaker ()
  (with-selffix-root ()
    (dotimes (i 2) (nodecode-selffix::record "failed" :fp "f1"))
    (is (null (nodecode-selffix::breaker (nodecode-selffix::ledger-rows))) "two failures do not pause")
    (nodecode-selffix::record "failed" :fp "f2")
    (is (equal "3 failed cycles in a row" (nodecode-selffix::breaker (nodecode-selffix::ledger-rows))))
    (nodecode-selffix::record "started" :by "s-op")
    (is (null (nodecode-selffix::breaker (nodecode-selffix::ledger-rows))) "an operator start resumes it")
    (dotimes (i 2) (nodecode-selffix::record "failed" :fp "f3"))
    (nodecode-selffix::record "not-reproduced" :fp "f4")
    (nodecode-selffix::record "failed" :fp "f5")
    (is (= 1 (nodecode-selffix::failure-streak (nodecode-selffix::ledger-rows)))
        "a cycle that ran to an outcome ends the streak")))

(deftest selffix-cell-ledger-eligible ()
  (with-selffix-root ()
    (let* ((tried (selffix-item "tried thrice" :count 9))
           (found (selffix-item "already found" :count 8))
           (gone (selffix-item "dropped before" :count 7))
           (fresh (selffix-item "fresh one" :count 1))
           (fp #'nodecode-selffix::fingerprint))
      (dotimes (i 3) (nodecode-selffix::record "not-reproduced" :fp (funcall fp tried)))
      (nodecode-selffix::record "finding" :fp (funcall fp found))
      (nodecode-selffix::record "dropped" :fp (funcall fp gone))
      (multiple-value-bind (kept dropped)
          (nodecode-selffix::eligible (list tried found gone fresh) (nodecode-selffix::ledger-rows))
        (is (equal (list fresh) kept) "only the fresh item runs, in the backlog's order")
        (is (equal (list tried) dropped) "an item tried three times is dropped now")))))

(deftest selffix-cell-ledger-stop ()
  (with-selffix-root ()
    (is (null (nodecode-selffix::stopped (nodecode-selffix::ledger-rows))) "no stop on an empty ledger")
    (nodecode-selffix::record "stopped" :by "s-op")
    (nodecode-selffix::record "failed" :fp "x")
    (is (equal "s-op" (nodecode-selffix::row (nodecode-selffix::stopped (nodecode-selffix::ledger-rows)) "by"))
        "a stop stands until a start")
    (nodecode-selffix::record "started" :by "s-op")
    (is (null (nodecode-selffix::stopped (nodecode-selffix::ledger-rows))))))
