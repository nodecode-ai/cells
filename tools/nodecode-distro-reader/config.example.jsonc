// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it. Nothing here
// is required: Distro's public reader needs no key and no account.
{
  "distro-reader": {
    "enabled": true,
    "endpoint": "https://reader.distro.media/mcp/reader/stream",
    "timeout_seconds": 60,
    "html_delivery": "link",
    "page_limit": 10,
    "max_chars": 20000
  }
}
