// The secret-handoff section of ~/.nodecode/config.jsonc — documentation, not
// config: the folder gets pushed and holds no secret. A present section is
// enabled; "enabled": false vetoes it. The browser and its CDP endpoint are
// the operator's, reached over loopback.
{
  "secret-handoff": {
    "enabled": true,
    "cdp_url": "http://127.0.0.1:9222",  // where Chrome --remote-debugging-port=9222 answers
    "prompt_seconds": 90,                 // how long one handoff waits for the operator to type
    "cdp_seconds": 8,                     // one CDP exchange's whole budget
    "allow_remote_cdp": false             // off: a cdp_url that is not this machine is refused
  }
}
