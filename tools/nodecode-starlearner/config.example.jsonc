// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "starlearner": {
    "token_env": "STARLEARNER_GITHUB_TOKEN",  // the variable holding the read-only GitHub token
    "data_dir": "starlearner",                // where the ledger and the notes live; empty: <home>/starlearner
    "max_pages": 30,                          // the hard cap on the stars fetch, 100 a page
    "generate_limit": 5,                      // notes per category per run, highest stars first; 0: none
    "timeout_seconds": 30                     // one GitHub request's ceiling
  }
}
