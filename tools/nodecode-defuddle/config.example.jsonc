// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret. A
// present section is enabled; "enabled": false vetoes it.
{
  "defuddle": {
    "enabled": true,

    // The defuddle program: its name on PATH (npm i -g defuddle), or a path
    // to it. A cell that cannot find it refuses to start and says so.
    "program": "defuddle",

    // How long one page may take to be read, in seconds. A program past it is
    // killed and the call answers ERROR: DEFUDDLE-ERROR.
    "timeout_seconds": 60
  }
}
