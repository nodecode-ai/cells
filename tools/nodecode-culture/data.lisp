;;;; data.lisp --- the bundled research data: 57 economies, 11 regional playbooks.
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; Positions distilled from Erin Meyer's The Culture Map (2014 scale charts),
;;;; Hofstede Insights country scores, GLOBE cluster research and Richard
;;;; Lewis's culture-type model: directional approximations for orientation,
;;;; not measurements. A country marked :EXTRAPOLATED T is not in the
;;;; published sets and is positioned from its GLOBE cluster neighbours.
;;;;
;;;; One line per country and per region, so a reader can diff two of them
;;;; without a formatter: a country's :MEYER vector is in *MEYER-SCALES*'
;;;; order, 0-100, and its :HOFSTEDE vector in *HOFSTEDE-DIMS*' order.

(in-package #:nodecode-culture)

(defparameter *meyer-scales*
  '((:key "comm" :label "Communicating" :low "low-context (explicit, precise)" :high "high-context (implicit, layered)")
    (:key "eval" :label "Evaluating" :low "direct negative feedback" :high "indirect negative feedback (upgraders, third parties)")
    (:key "lead" :label "Leading" :low "egalitarian (boss as peer)" :high "hierarchical (boss as father figure / status distance)")
    (:key "decide" :label "Deciding" :low "consensual (group decides)" :high "top-down (boss decides)")
    (:key "trust" :label "Trusting" :low "task-based trust (from competence/reliability)" :high "relationship-based trust (from meals, time, family)")
    (:key "dis" :label "Disagreeing" :low "confrontational (open debate is good)" :high "avoids confrontation (open debate harms harmony)")
    (:key "sched" :label "Scheduling" :low "linear-time (agenda, punctuality)" :high "flexible-time (relationships > clock)")
    (:key "pers" :label "Persuading" :low "applications-first (conclusion up front)" :high "principles-first (theory before application)"))
  "The eight Meyer scales, in the order a country's :MEYER vector holds them.")

(defparameter *hofstede-dims*
  '((:key "pdi" :label "Power Distance")
    (:key "idv" :label "Individualism")
    (:key "mas" :label "Motivation towards Achievement and Success (masculinity)")
    (:key "uai" :label "Uncertainty Avoidance")
    (:key "lto" :label "Long-Term Orientation")
    (:key "ivr" :label "Indulgence vs Restraint"))
  "Hofstede's six dimensions, in the order a country's :HOFSTEDE vector holds them.")

(defparameter *countries*
