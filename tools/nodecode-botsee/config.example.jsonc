// The section ~/.nodecode/config.jsonc may carry for this peripheral —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration
// of it. A present section is enabled; "enabled": false vetoes it.
{
  "botsee": {
    "enabled": true,
    "api_key": "your-botsee-api-key",
    "api_key_env": "MCP_BOTSEE_API_KEY",
    "url": "https://botsee.io/mcp",
    "protocol_version": "2025-06-18",
    "timeout_seconds": 90
  }
}
