  "Every printable ASCII character, then its seven rows of five: '#' inks a
pixel, '.' leaves it blank, '|' separates the rows.")

(defparameter +box+
  (vector "#####" "#####" "#####" "#####" "#####" "#####" "#####")
  "What a character with no entry of its own draws as: the filled box.")

(defun split-rows (text)
  "TEXT, its rows separated by '|', as a vector of seven row strings."
  (coerce (loop with start = 1
                for end = (position #\| text :start start)
                collect (subseq text start (or end (length text)))
                while end
                do (setf start (1+ end)))
          'vector))

(defparameter *glyphs*
  (let ((table (make-hash-table :test #'eq :size 128)))
    (loop for (character text) on +font-table+ by #'cddr
          do (setf (gethash character table) (split-rows text)))
    table)
  "CHARACTER => its seven rows of five, '#' an inked pixel.")

(defun glyph-rows (character)
  "CHARACTER's seven rows of five: its own, or the filled box."
  (or (gethash character *glyphs*) +box+))
