// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority. A present section is
// enabled; "enabled": false vetoes it. Every member is optional: with no
// key the cell still starts and says nothing.
{
  "skill-router": {
    // the variable holding the TypeSafe key; empty sends none
    "api_key_env": "TYPESAFE_API_KEY",
    // empty: https://api.typesafe.ai, or a base of your own speaking the same POST
    "base_url": "",
    // empty: jev-latest
    "model": "",
    "gate": "0.30",
    "fits": "0.40",
    "shortlist": 3,
    "chunk": 240,
    "excerpt": 700,
    "timeout": 10,
    "suggest_chars": 4000
  }
}
