// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. Keys live in auth.json (api_keys.typesafe, or
// api_keys.cloudflare-jev) or in TYPESAFE_API_KEY and
// CLOUDFLARE_JEV_API_TOKEN, never here.
{
  "jev": {
    "enabled": true,

    // Which route answers. One is chosen explicitly; there is no fallback.
    "backend": "typesafe",

    // Cloudflare only: the 32-hex-digit account id the AI run route names.
    "account_id": "",

    // Cloudflare only, optional: an AI Gateway to route through.
    "gateway_id": "",

    // The model id. Empty is jev-latest at TypeSafe, typesafe/jev at
    // Cloudflare.
    "model": "",

    // Empty turns the review heuristic off. Otherwise a number between 0.5
    // and 1: an answer whose probability sits near the middle, or whose
    // confidence is under it, is named as one worth a human look.
    "review_threshold": ""
  }
}
