// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. Secrets never belong here: the CLI keeps its own login, and a
// playbook key lives in the environment the target profile runs with.
{
  "agentplaybooks": {
    "enabled": true,

    // The guid of the playbook you work with. Required: the tools use it
    // whenever a call names no playbook of its own.
    "playbook": "",

    // The AgentPlaybooks CLI executable, found on PATH
    // (npm install -g @agentplaybooks/cli, Node.js 20 or later).
    "binary": "apb",

    // The harness the CLI writes for: `apb TARGET setup` and --target=TARGET.
    "target": "hermes",

    // The profile the CLI writes, as --profile=NAME. Empty: its default.
    "profile": "",

    // The installation directory the CLI writes into, as --hermes-home=DIR.
    // Empty: its default.
    "hermes_home": "",

    // The project the CLI runs in. Empty: the asking session's directory.
    "directory": "",

    // Seconds one CLI call may take before its whole process tree is killed.
    "timeout": 180,

    // How much of one answer the model is given, in characters.
    "max_chars": 20000
  }
}
