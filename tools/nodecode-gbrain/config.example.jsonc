// The section ~/.nodecode/config.jsonc may carry for this cell. The
// declaration in cell.lisp is the authority; this is an illustration of it.
// A present section is enabled; "enabled": false vetoes it.
{
  "gbrain": {
    "enabled": true,
    "url": "http://127.0.0.1:3131/mcp",
    // one of these three names the bearer token
    "token_env": "GBRAIN_TOKEN",
    // "token": "a token the GBrain server minted",
    // "token_file": "~/.gbrain/hermes-mcp.token",
    "max_pages": 5,
    "min_confidence": "0.6",
    "history_turns": 6,
    "synopsis_chars": 400,
    "max_context_bytes": 3200,
    "ambient": true,
    "timeout_seconds": 8
  }
}
