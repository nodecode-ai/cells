// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder holds no secret. The declaration in
// cell.lisp is the authority. A present section is enabled; "enabled": false
// vetoes it.
{
  "plan-mode": {
    "enabled": true,
    "plans_dir": "",
    "ask_seconds": 180,
    "allow_commits": false
  }
}
