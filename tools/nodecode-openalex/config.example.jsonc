// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// A present section is enabled; "enabled": false vetoes it. No key is
// required: without one every call runs on OpenAlex's anonymous tier.
{
  "openalex": {
    "enabled": true,
    "api_key": null,                  // or name the variable in api_key_env
    "api_key_env": "OPENALEX_API_KEY",
    "profile": "core",                // "full" adds classify, harvest and fulltext
    "verbosity": "summary",           // summary, detail or raw
    "budget_usd": "0.05",             // this cell's spend ceiling, in dollars
    "allow_text_classification": false,
    "timeout_seconds": 30,
    "max_result_chars": 24000
  }
}
