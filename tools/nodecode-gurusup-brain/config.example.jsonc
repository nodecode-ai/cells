// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it. A section with
// no token refuses at start; token_env names a variable instead, and
// GURUSUP_BRAIN_TOKEN is read either way.
{
  "gurusup-brain": {
    "enabled": true,
    "token": "…",
    "token_env": "GURUSUP_BRAIN_TOKEN",
    "endpoint": "https://mcp.brain.gurusup.com/mcp",
    "timeout_seconds": 45
  }
}
