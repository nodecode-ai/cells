// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "cartograph": {
    "enabled": true,
    // absolute directories the cell may read; absent leaves every local
    // directory open, an empty list allows none
    "allowed_roots": ["/absolute/path/to/code"],
    // extra directory names the walk skips, besides its own set
    "ignore": ["fixtures"],
    // code files read before the walk stops
    "max_files": 2000,
    // the longest excerpt of one file, in characters
    "source_chars": 8000,
    // the ceiling on one answer, in characters
    "max_output_chars": 40000
  }
}
