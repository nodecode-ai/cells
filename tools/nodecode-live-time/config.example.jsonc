// The section ~/.nodecode/config.jsonc may carry for this cell -- documentation,
// not config: the folder holds no secret. The declaration in cell.lisp is the
// authority; this is an illustration of it. A present section is enabled;
// "enabled": false vetoes it.
{
  "live-time": {
    "enabled": true,
    "timezone": "Europe/Berlin",
    "zoneinfo_dir": "/usr/share/zoneinfo"
  }
}
