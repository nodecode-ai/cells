// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration.
// A present section is enabled; "enabled": false vetoes it.
{
  "costguard": {
    "enabled": true,
    // billable tokens (input, output and reasoning; cache reads are free)
    "session_token_budget": 200000,
    "daily_token_budget": 1000000,
    // US dollars, written as a string: empty is off
    "session_cost_budget_usd": "2.00",
    "daily_cost_budget_usd": "10.00",
    // where the model is told to finish what it started
    "warn_percent": 80
  }
}
