// The section Nodecode's shared config may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it.
{
  "patsnap": {
    "enabled": true,
    "endpoint": "https://connect.patsnap.com/2b0355/logic-mcp",
    "api_key": "<a reference to the key, never the key itself in a pushed file>",
    "api_key_env": "PATSNAP_API_KEY",
    "tool_prefix": "patsnap",
    "language": "en",
    "limit": 10,
    "timeout": 60
  }
}
