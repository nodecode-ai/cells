// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json (/devin login), or the key in
// DEVIN_API_KEY.
{
  "devin": {
    "enabled": true,

    // Where Codeium's Cascade is served: the devin lane calls GetUserJwt,
    // AssignModel, GetChatMessage and GetCliModelConfigs here. An account
    // whose GetUserJwt names a chat host of its own is sent there instead.
    "base_url": "https://server.codeium.com"
  }
}
