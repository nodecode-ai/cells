// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or ANYAPI_API_KEY.
{
  "anyapi": {
    "enabled": true,

    // Where AnyAPI is served. The chat lane appends /chat/completions.
    "base_url": "https://api.anyapi.ai/v1",

    // A turn always offers tools, so only the routes AnyAPI tags
    // function_calling are listed. false lists every route it serves.
    "tool_capable": true,

    // One catalog read's ceiling, in seconds.
    "timeout_seconds": 8
  }
}
