// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json under api_keys.llmapi (what
// /connect saves) or in LLMAPI_API_KEY.
{
  "llmapi": {
    "enabled": true,

    // Where the gateway is served. Each lane appends its own path:
    // /chat/completions, /messages or /responses.
    "base_url": "https://api.llmapi.ai/v1"
  }
}
