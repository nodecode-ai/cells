// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The proxy pays from a funded wallet, so no key is needed here:
// the key itself lives in auth.json (/connect) or ZEROSIGNAL_API_KEY.
{
  "zerosignal": {
    "enabled": true,

    // Where the local proxy listens. The chat lane appends /chat/completions.
    "base_url": "http://127.0.0.1:9376/v1"
  }
}
