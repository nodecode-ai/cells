// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or GONDOLA_API_KEY.
{
  "gondola": {
    "enabled": true,

    // Where Gondola is served. The chat lane appends /chat/completions, and
    // the model catalog is read at /models.
    "base_url": "https://api.gondola-ai.com/v1"
  }
}
