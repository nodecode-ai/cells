// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or
// OPENROUTER_API_KEY.
{
  "hopper": {
    "enabled": true,

    // Where OpenRouter is served. The chat lane appends /chat/completions.
    "base_url": "https://openrouter.ai/api/v1",

    // The list: one OpenRouter model id a line, `#` a comment. Empty names
    // hopper/models.txt in the organism's home.
    "models_file": ""
  }
}
