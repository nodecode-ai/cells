// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or BHARATCODE_API_KEY.
{
  "bharatcode": {
    "enabled": true,

    // Where BharatCode is served. The chat lane appends /chat/completions.
    "base_url": "https://bharatcode.ai/api/model/v1"
  }
}
