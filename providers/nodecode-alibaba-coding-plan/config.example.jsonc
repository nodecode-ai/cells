// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or
// ALIBABA_CODING_PLAN_API_KEY.
{
  "alibaba-coding-plan": {
    "enabled": true,

    // Where the plan was bought. The two regions are separate products and
    // their keys do not cross:
    //   international  https://coding-intl.dashscope.aliyuncs.com/v1
    //   china          https://coding.dashscope.aliyuncs.com/v1
    "region": "international"

    // A custom endpoint, a proxy; set, it wins over region. The chat lane
    // appends /chat/completions.
    // "base_url": "https://your-proxy.example/v1"
  }
}
