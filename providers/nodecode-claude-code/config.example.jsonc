// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret (the
// login is the claude CLI's own, where `claude' then /login wrote it). A
// present section is enabled; "enabled": false vetoes it. Every member is
// optional.
{
  "claude-code": {
    "enabled": true,

    // The Claude Code CLI: a name on PATH, or a path.
    "command": "claude",

    // /models lists what the login may call (Anthropic's own model listing,
    // asked with the CLI's headers). These Anthropic model ids join it: an
    // alias, or an id the listing leaves out. A model's window, output
    // ceiling and effort ladder are read off Anthropic's own catalog row, and
    // a model whose window is past 200K runs on its 1M route.
    "models": ["claude-haiku-4-5"],

    // How long the CLI may take to write one round's request, replaying the
    // session's history included (about 2 ms a user turn).
    "timeout_seconds": 120,

    // How long the request the CLI last wrote is sent again around a later
    // round's own messages, when the round's system text, tools, model,
    // effort, output ceiling, thinking, folder and first user message are
    // the same: such a round starts no CLI. 0 starts the CLI every round.
    "reuse_seconds": 600
  }
}
