// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or TELNYX_API_KEY.
{
  "telnyx": {
    "enabled": true,

    // Where Telnyx inference is served. The chat lane appends /chat/completions.
    "base_url": "https://api.telnyx.com/v2/ai/openai"
  }
}
