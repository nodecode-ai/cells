// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or OPENPATHS_API_KEY.
{
  "openpaths": {
    "enabled": true,

    // Where OpenPaths is served. The chat lane appends /chat/completions.
    "base_url": "https://openpaths.io/v1"
  }
}
