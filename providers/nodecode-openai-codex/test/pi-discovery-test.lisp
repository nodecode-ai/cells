;;;; Synthetic-only native inventory/catalog proofs. No operator store is opened.
(in-package #:nodecode.test)

(defmacro with-oc-pi-discovery ((&optional (accounts '(list "openai-codex" "openai-codex-2"))) &body body)
  `(with-temp-shared-config ("{}")
     (with-temp-auth (auth "{}")
       (let ((nle::*auth-file-path* auth) (nle::*api-key* nil) (nle::*endpoint* nil)
             (nle::*models-catalog-path* nil) (nle::*models-catalog-url* nil)
             (nle::*provider* "openai-codex") (nle::*model* "gpt-6.1-sol")
             (available ,accounts) (discoveries 0))
         (with-stubbed-fdefinition
             (nodecode-openai-codex::call-pi-helper (source entry probe)
               (if (eq source :discover)
                   (progn (incf discoveries) (nlk:json-object "accounts" (coerce available 'vector)))
                   (if (member source available :test #'equal) (oc-pi-answer source)
                       (nle::credential-fail "synthetic account removed"))))
           (with-cell-stop ((openai-codex-start "pi_accounts" t)) ,@body))))))

(deftest openai-codex-cell-pi-discovers-native-ids-and-catalog-without-config ()
  (with-oc-pi-discovery ()
    (is (null (nle::provider-config-entries)))
    (is (equal '("openai-codex" "openai-codex-2") (nle::connected-provider-ids)))
    (dolist (id available)
      (let ((row (gethash id (nle::models-catalog-table)))
            (config (nle::snapshot-effective-provider-config id "gpt-6.1-sol")))
        (is (gethash "gpt-6.1-sol" (nlk:json-value row :object "models")))
        (is (equal (format nil "synthetic-~a" id) (nle::effective-provider-config-api-key config)))
        (is (equal (format nil "account-~a" id)
                   (oc-header (nle::credential-attribute config :headers) "chatgpt-account-id")))))
    (is (= 1 discoveries))
    (dolist (id available)
      (let ((entry (nle::configured-provider-entry id)))
        (is (equal id (gethash "pi_auth" entry)))
        (is (gethash "pi_discovered" entry))
        (is (null (gethash "api_key" entry)))
        (is (null (gethash "access_token" entry)))))
    (is (null (nle::failover-chain)))
    (is (null (nlk:json-value (nle:read-shared-config) :object "general" "default_model")))))

(deftest openai-codex-cell-pi-numbered-only-native-inventory-stays-numbered ()
  (with-oc-pi-discovery ((list "openai-codex-2"))
    (is (equal '("openai-codex-2") (nle::connected-provider-ids)))
    (is (find-if (lambda (row) (and (equal "openai-codex-2" (getf row :provider))
                                   (equal "gpt-6.1-sol" (getf row :model)))) (nle::model-choices)))))

(deftest openai-codex-cell-pi-native-sign-in-keeps-ownership-on-collision ()
  (with-oc-pi-discovery ()
    (with-temp-auth (native (oc-store))
      (let ((nle::*auth-file-path* native))
        (is (null (nodecode-openai-codex::pi-source "openai-codex")))
        (is (equal +oc-access+ (nle:credential-key (nle::resolve-provider-credential "openai-codex"))))
        (is (equal "openai-codex-2" (nodecode-openai-codex::pi-source "openai-codex-2")))))))

(deftest openai-codex-cell-pi-explicit-non-pi-config-is-not-shadowed ()
  (with-oc-pi-discovery ()
    (with-temp-shared-config ("{\"providers\":{\"openai-codex-2\":{\"sdk\":\"anthropic\",\"base_url\":\"https://explicit.invalid\",\"api_key\":\"synthetic-override\"}}}")
      (is (null (nodecode-openai-codex::pi-source "openai-codex-2")))
      (is (equal "anthropic" (nle::configured-provider-lane "openai-codex-2")))
      (is (equal "synthetic-override" (nle:credential-key (nle::resolve-provider-credential "openai-codex-2")))))))

(deftest openai-codex-cell-pi-inventory-refreshes-but-logout-never-borrows-another-login ()
  (with-oc-pi-discovery ()
    (is (member "openai-codex-2" (nle::connected-provider-ids) :test #'equal))
    (let ((before (nle::models-catalog-table)))
      (setf available (list "openai-codex") nodecode-openai-codex::*pi-discovery* nil)
      (is (not (member "openai-codex-2" (nle::connected-provider-ids) :test #'equal)))
      (is (not (eq before (nle::models-catalog-table))))
      (is (null (gethash "openai-codex-2" (nle::models-catalog-table)))))
    (with-stubbed-fdefinition (nle::env-credential (&rest args) (error "must not borrow environment"))
      (is (signals-error nle:credential-error (nle::resolve-provider-credential "openai-codex-2")))
      (is (eq :none (nle::provider-auth-state "openai-codex-2"))))))

(deftest openai-codex-cell-pi-unavailable-discovery-never-breaks-native-cell ()
  (with-oc-pi-discovery ()
    (with-stubbed-fdefinition (nodecode-openai-codex::call-pi-helper (&rest args)
                               (nle::credential-fail "synthetic missing Pi or busy lock"))
      (is (null (nodecode-openai-codex::pi-accounts)))
      (is (gethash "openai-codex" (nle::models-catalog-table)))
      (is (null (nle::connected-provider-ids))))))

(deftest openai-codex-cell-pi-discovery-can-be-disabled-without-helper-or-store ()
  (with-cell-stop ((openai-codex-start))
    (with-temp-shared-config ("{}")
      (with-stubbed-fdefinition (nodecode-openai-codex::call-pi-helper (&rest args)
                                 (error "disabled discovery opened a store"))
        (is (null (nodecode-openai-codex::pi-accounts)))
        (is (gethash "openai-codex" (nle::models-catalog-table)))))))

(deftest openai-codex-cell-pi-caller-auth-path-keeps-native-account-in-both-directions ()
  (with-oc-pi-discovery ()
    (nle::connected-provider-ids)
    (with-temp-auth (native (oc-store))
      (is (equal +oc-access+
                 (nle:credential-key (nle::resolve-provider-credential "openai-codex" :auth-path native))))
      (let ((empty nle::*auth-file-path*) (nle::*auth-file-path* native))
        (is (equal "synthetic-openai-codex"
                   (nle:credential-key (nle::resolve-provider-credential "openai-codex" :auth-path empty))))))))

(deftest openai-codex-cell-pi-logout-and-restart-retain-the-imported-source ()
  (with-oc-pi-discovery ()
    (nle::connected-provider-ids)
    (setf available nil)
    (funcall stop)
    (setf stop nil)
    (with-cell-stop ((openai-codex-start "pi_accounts" t))
      (with-stubbed-fdefinition (nle::credential-env (name)
                                 "synthetic-unrelated-environment-account")
        (is (signals-error nle:credential-error (nle::resolve-provider-credential "openai-codex")))
        (is (eq :none (nle::provider-auth-state "openai-codex")))))))

(deftest openai-codex-cell-pi-delegated-listing-cannot-race-into-pi-credentials ()
  (with-oc-pi-discovery ()
    (nle::connected-provider-ids)
    (let ((changed nil))
      (with-stubbed-fdefinition (nodecode-openai-codex::pi-source (provider)
                                 (when changed "openai-codex"))
        (is (signals-error nle:credential-error
              (nodecode-openai-codex::pi-list-models
               (lambda (provider &rest keys)
                 (declare (ignore keys))
                 (setf changed t)
                 (nle::resolve-provider-credential provider)) "openai-codex")))))))

(deftest openai-codex-cell-pi-cannot-import-into-unwritable-config-or-borrow-environment ()
  (with-oc-pi-discovery ()
    (with-stubbed-fdefinition (nlk:write-file-atomically (&rest args) (error "synthetic readonly"))
      (with-stubbed-fdefinition (nle::credential-env (&rest args) "synthetic-wrong-account")
        (is (signals-error nle:credential-error (nle::resolve-provider-credential "openai-codex")))))))

(deftest openai-codex-cell-pi-readonly-import-preserves-explicit-and-native-api-keys-at-freeze ()
  (with-oc-pi-discovery ()
    (with-temp-auth (native "{\"api_keys\":{\"openai-codex\":{\"key\":\"synthetic-native-key\"}}}")
      (with-stubbed-fdefinition (nlk:write-file-atomically (&rest args) (error "synthetic readonly"))
        (let ((nle::*api-key* "synthetic-explicit-key"))
          (is (equal "synthetic-explicit-key"
                     (nle::effective-provider-config-api-key (nle::snapshot-effective-provider-config)))))
        (let ((nle::*auth-file-path* native))
          (is (equal "synthetic-native-key"
                     (nle::effective-provider-config-api-key (nle::snapshot-effective-provider-config)))))))))

(deftest openai-codex-cell-pi-import-rechecks-a-provider-created-after-discovery ()
  (with-oc-pi-discovery ()
    (let ((original (symbol-function 'nodecode-openai-codex::pi-import-account)))
      (with-stubbed-fdefinition
          (nodecode-openai-codex::pi-import-account (id)
            (nle::persist-shared-config (list "providers" id)
                                       (nlk:json-object "sdk" "anthropic" "api_key" "synthetic-explicit"))
            (funcall original id))
        (is (null (nodecode-openai-codex::pi-source "openai-codex")))
        (dolist (id available)
          (let ((entry (nle::configured-provider-entry id)))
            (is (equal "anthropic" (gethash "sdk" entry)))
            (is (equal "synthetic-explicit" (gethash "api_key" entry)))
            (is (null (gethash "pi_auth" entry)))))))))
