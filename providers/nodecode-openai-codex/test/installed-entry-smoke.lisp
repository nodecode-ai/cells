(handler-case
    (let ((nlk::*cells-directory* (merge-pathnames "cells/" (nlk:home)))
          (nle::*models-catalog-path* nil) (nle::*models-catalog-url* nil)
          (nle::*api-key* nil) (nle::*endpoint* nil)
          (nle::*provider* "openai-codex") (nle::*model* "gpt-6.1-sol")
          (nle::*max-stream-retries* 0) (nle::*max-request-retries* 0)
          (nle::*failover* t))
      (nlk:load-cell "nodecode-openai-codex")
      (let ((stop (uiop:symbol-call :nodecode-openai-codex :start-cell (nle:read-shared-config)))
            (original (symbol-function 'dex:post))
            (requests '()) (fail-first nil) (count 0))
        (unwind-protect
             (progn
               (assert (null (nle::provider-config-entries)))
               (let ((connected (nle::connected-provider-ids)) (rows (nle::model-choices)))
                 (dolist (id '("openai-codex" "openai-codex-2"))
                   (assert (member id connected :test #'equal))
                   (assert (find-if (lambda (row) (and (equal id (getf row :provider))
                                                      (equal "gpt-6.1-sol" (getf row :model)))) rows))))
               (setf (symbol-function 'dex:post)
                     (lambda (url &rest keys)
                       (incf count)
                       (let* ((headers (getf keys :headers))
                              (body (nlk:decode-json (getf keys :content)))
                              (account (cdr (assoc "chatgpt-account-id" headers :test #'string-equal)))
                              (reply-headers (make-hash-table :test 'equal)))
                         (push (list url headers body) requests)
                         (setf (gethash "x-codex-turn-state" reply-headers) (concatenate 'string "sticky-" account))
                         (if (and fail-first (= count 1))
                             (values (make-string-input-stream "{}") 429 reply-headers)
                             (values (make-string-input-stream
                                      (format nil "data: {\"type\":\"response.output_text.delta\",\"item_id\":\"m\",\"delta\":\"ok\"}~%~%data: {\"type\":\"response.done\",\"response\":{\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}}~%~%"))
                                     200 reply-headers)))))
               (flet ((context ()
                        (nle::compile-turn-context
                         (nle::snapshot-context-request nil :messages (list (nle::message "user" "synthetic smoke")))))
                      (header (request name)
                        (cdr (assoc name (second request) :test #'string-equal))))
                 (dolist (provider '("openai-codex" "openai-codex-2" "openai-codex"))
                   (let ((nle::*provider* provider))
                     (assert (equal "ok" (gethash "content" (nle::call-responses-streaming (context)))))))
                 (let* ((ordered (reverse requests)) (one (first ordered)) (two (second ordered)) (again (third ordered)))
                   (assert (= 3 (length ordered)))
                   (assert (equal "synthetic-one" (header one "chatgpt-account-id")))
                   (assert (equal "synthetic-two" (header two "chatgpt-account-id")))
                   (assert (equal "Bearer synthetic-access-one" (header one "authorization")))
                   (assert (equal "Bearer synthetic-access-two" (header two "authorization")))
                   (assert (not (equal (header one "thread-id") (header two "thread-id"))))
                   (assert (equal (header one "thread-id") (header again "thread-id")))
                   (assert (null (header two "x-codex-turn-state")))
                   (assert (equal "sticky-synthetic-one" (header again "x-codex-turn-state")))
                   (assert (not (equal (gethash "prompt_cache_key" (third one)) (gethash "prompt_cache_key" (third two)))))
                   (dolist (request ordered)
                     (assert (equal "https://chatgpt.com/backend-api/codex/responses" (first request)))
                     (assert (null (gethash "max_output_tokens" (third request))))
                     (assert (gethash "client_metadata" (third request)))))
                 (setf requests nil count 0 fail-first t)
                 (assert (equal "ok" (gethash "content" (nle::call-provider (context)))))
                 (assert (equal "ok" (gethash "content" (nle::call-provider (context)))))
                 (assert (equal '("synthetic-one" "synthetic-two" "synthetic-one")
                                (mapcar (lambda (request) (header request "chatgpt-account-id")) (reverse requests))))
                 (assert (equal "openai-codex" nle::*provider*))
                 42))
          (setf (symbol-function 'dex:post) original)
          (when stop (funcall stop)))))
  (error (condition)
    (with-open-file (out (merge-pathnames "accounts-error.txt" (user-homedir-pathname))
                         :direction :output :if-exists :supersede)
      (princ condition out))
    0))
