// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or ABSTRACT_API_KEY.
{
  "abstract": {
    "enabled": true,

    // Where the Responses API is served. The lane appends /responses.
    "base_url": "https://api.abstract.inc/v1"
  }
}
