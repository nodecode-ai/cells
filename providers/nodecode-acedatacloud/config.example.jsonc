// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. A key typed into /connect wins over the variable below.
{
  "acedatacloud": {
    "enabled": true,

    // Where Ace Data Cloud is served. The chat lane appends
    // /chat/completions; the model listing asks /models beside it.
    "base_url": "https://api.acedata.cloud/openai",

    // One model-listing fetch's ceiling, in seconds.
    "timeout_seconds": 10
  }
}
