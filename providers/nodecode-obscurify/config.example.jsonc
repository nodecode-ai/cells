// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or
// OBSCURIFY_API_KEY.
{
  "obscurify": {
    "enabled": true,

    // Where Obscurify.ai is served. The chat lane appends /chat/completions.
    "base_url": "https://obscurify.ai/v1",

    // Leave out catalog models whose context window is under this many
    // tokens. The plugin dropped models under 64K, the floor Hermes needed.
    "min_context_tokens": 64000,

    // One catalog read's ceiling, in seconds.
    "timeout_seconds": 8
  }
}
