// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or CHUTES_API_KEY.
{
  "chutes": {
    "enabled": true,

    // Where Chutes is served. The chat lane appends /chat/completions.
    // Left out, CHUTES_BASE_URL answers and then
    // https://llm.chutes.ai/v1.
    "base_url": "https://llm.chutes.ai/v1"
  }
}
