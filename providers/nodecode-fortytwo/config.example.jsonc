// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config: the folder gets pushed and holds no secret. A
// present section is enabled; "enabled": false vetoes it. The key itself
// lives in auth.json (/connect) or FORTYTWO_API_KEY.
{
  "fortytwo": {
    "enabled": true,

    // Where Fortytwo is served. The chat lane appends /chat/completions.
    "base_url": "https://api.fortytwo.network/v1"
  }
}
