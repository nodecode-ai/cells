// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json under api_keys.liquid (/connect
// liquid saves it there), or in LIQUID_API_KEY.
{
  "liquid": {
    "enabled": true,

    // Where the exchange is served. The chat lane appends /chat/completions.
    "base_url": "https://router.inference.ai.exchange/v1",

    // The most one request may be charged, in USD, sent as x-liquid-cap-usd:
    // digits with at most one dot, and not zero. The exchange's own default
    // is 1.00.
    "cap_usd": "1.00"
  }
}
