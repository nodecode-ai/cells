// The section ~/.nodecode/config.jsonc may carry for this cell —
// documentation, not config: the folder gets pushed and holds no secret.
// The declaration in cell.lisp is the authority; this is an illustration of
// it. A present section is enabled; "enabled": false vetoes it. The key
// itself is not here: /connect saves it, or NGROK_AI_GATEWAY_KEY holds it.
{
  "ngrok-ai-gateway": {
    "enabled": true,
    // where the gateway is served; a relay's address or another gateway goes here
    "base_url": "https://gateway.ngrok.ai/v1"
  }
}
