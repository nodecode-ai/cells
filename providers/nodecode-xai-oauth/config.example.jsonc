// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json (/xai-oauth); a token may
// instead be set in XAI_OAUTH_TOKEN.
{
  "xai-oauth": {
    "enabled": true,

    // Where xAI is served. The Responses lane appends /responses;
    // xai_oauth_image appends /images/generations.
    "base_url": "https://api.x.ai/v1",

    // The existing directory xai_oauth_image writes into; it takes leaf
    // filenames only and never overwrites.
    "media_root": ".",

    // The Grok Imagine model xai_oauth_image asks.
    "image_model": "grok-imagine-image"
  }
}
