// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or ANYROUTER_API_KEY.
{
  "anyrouter": {
    "enabled": true,

    // Where AnyRouter is served. The chat lane appends /chat/completions.
    "base_url": "https://anyrouter.dev/api/v1",

    // Credit Nodecode's traffic in AnyRouter's public app rankings. Off by
    // default: nothing is tagged unless asked for.
    "attribution": false,

    // Upstream routing preferences, sent as the body's "provider".
    "only": [],
    "ignore": [],
    "order": [],
    "sort": "default",
    "allow_fallbacks": "default"
    // "max_price": 5             // whole US dollars per million tokens
  }
}
