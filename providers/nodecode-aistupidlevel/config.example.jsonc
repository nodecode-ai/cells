// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or ASL_ROUTER_KEY.
{
  "aistupidlevel": {
    "enabled": true,

    // Where the router is served. The chat lane appends /chat/completions.
    "base_url": "https://aistupidlevel.info/v1"
  }
}
