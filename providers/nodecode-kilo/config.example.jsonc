// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json under oauth_tokens.kilo
// (/kilo login); a key lives in auth.json (/connect) or KILO_API_KEY.
{
  "kilo": {
    "enabled": true,

    // Where Kilo Gateway is served. The chat lane appends /chat/completions.
    "base_url": "https://api.kilo.ai/api/gateway"
  }
}
