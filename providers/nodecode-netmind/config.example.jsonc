// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or NETMIND_API_KEY.
{
  "netmind": {
    "enabled": true,

    // Where NetMind is served. The chat lane appends /chat/completions to
    // it; a relay of your own is named here instead.
    "base_url": "https://api.netmind.ai/inference-api/v1"
  }
}
