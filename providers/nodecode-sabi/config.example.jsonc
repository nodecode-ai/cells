// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. There is no key: the upstream credential belongs to the proxy.
{
  "sabi": {
    "enabled": true,

    // Where Sabi is. The chat lane appends /chat/completions.
    "base_url": "http://127.0.0.1:8787/v1",

    // What the picker reports for the alias, and what a turn is sized against.
    "context_tokens": 65536
  }
}
