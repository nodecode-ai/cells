// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or AIHUBMIX_API_KEY.
{
  "aihubmix": {
    "enabled": true,

    // Where AIHubMix is served. The chat lane appends /chat/completions.
    "base_url": "https://aihubmix.com/v1"
  }
}
