// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect, or /mistral-vibe
// login) or MISTRAL_VIBE_API_KEY.
{
  "mistral-vibe": {
    "enabled": true,

    // Where the relay is served. The chat lane appends /chat/completions.
    "base_url": "https://api.mistral.ai/v1"
  }
}
