// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json (/snowflake login), a PAT in
// auth.json (/connect) or SNOWFLAKE_PAT.
{
  "snowflake": {
    "enabled": true,

    // The account a PAT is sent to, and the one /snowflake login signs in to
    // when it names none: orgname-accountname, or the account URL (else
    // SNOWFLAKE_ACCOUNT). A sign-in keeps its own account.
    "account": "myorg-myaccount"
  }
}
