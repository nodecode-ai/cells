// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The key itself lives in auth.json (/connect) or REQUESTY_API_KEY.
{
  "requesty": {
    "enabled": true,

    // Where Requesty is served. The chat lane appends /chat/completions;
    // Requesty's EU endpoint is https://router.eu.requesty.ai/v1.
    "base_url": "https://router.requesty.ai/v1"
  }
}
