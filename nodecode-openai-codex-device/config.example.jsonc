// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json under oauth_tokens.openai-codex
// (/openai-codex-device login), or a token in OPENAI_CODEX_OAUTH_TOKEN.
{
  "openai-codex-device": {
    "enabled": true,

    // The Codex backend: its root, its /codex, or its /codex/responses. A
    // relay's address goes here. With nodecode-openai-codex installed too,
    // set the same value in its section.
    "base_url": "https://chatgpt.com/backend-api",

    // The client name every request carries.
    "originator": "codex_cli_rs"
  }
}
