// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json (/xai-oauth login); a token may
// instead be set in XAI_OAUTH_TOKEN.
{
  "xai-oauth": {
    "enabled": true,

    // Where xAI is served. The Responses lane appends /responses.
    "base_url": "https://api.x.ai/v1"
  }
}
