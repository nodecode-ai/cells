// The section ~/.nodecode/config.jsonc may carry for this cell --
// documentation, not config. A present section is enabled; "enabled": false
// vetoes it. The sign-in lives in auth.json (/kimi-code login); a key may
// instead be saved with /connect or set in KIMI_API_KEY.
{
  "kimi-code": {
    "enabled": true,

    // Where Kimi Code is served. The Messages lane appends /messages.
    "base_url": "https://api.kimi.com/coding/v1"
  }
}
